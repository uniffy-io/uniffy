{
    "description": "Load path-scoped repository guidance from .agents/rules before Codex edits matching files.",
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup|resume|clear|compact",
                "hooks": [
                    {
                        "type": "command",
                        "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/load_path_rules.py\"",
                        "timeout": 10,
                        "statusMessage": "Loading repository rules",
                        "additionalContextLimit": 0
                    }
                ]
            }
        ],
        "SubagentStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/load_path_rules.py\"",
                        "timeout": 10,
                        "statusMessage": "Loading repository rules",
                        "additionalContextLimit": 0
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "^apply_patch$",
                "hooks": [
                    {
                        "type": "command",
                        "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/load_path_rules.py\"",
                        "timeout": 10,
                        "statusMessage": "Checking path-scoped repository rules",
                        "additionalContextLimit": 0
                    }
                ]
            }
        ]
    }
}
