# Caddyfile for production build testing
# Serves UI and proxies API requests to backend

localhost {
	# ConnectRPC services - proxy to backend
	# Matches paths like /notes.v1.NotesService/*
	@connectrpc path_regexp connectrpc ^/[a-z]+\.[a-z0-9]+\.[A-Za-z]+Service/.*
	handle @connectrpc {
		reverse_proxy backend:8000
	}

	# API routes - proxy to backend
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Health check
	handle /health {
		reverse_proxy backend:8000
	}

	# LiveKit signaling (WebSocket) - media goes direct via UDP, not here
	handle_path /livekit/* {
		reverse_proxy livekit:7880
	}

	# Everything else - serve from UI
	handle {
		reverse_proxy ui:80
	}
}
