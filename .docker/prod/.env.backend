# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=2
LOG_LEVEL=info
ENVIRONMENT=production
RELOAD=false

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=https://localhost

# Database Configuration
