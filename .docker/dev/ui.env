# In-container env for the Vite dev server.
# API_PROXY_TARGET tells vite where to forward /api/* to. Inside the docker
# network the backend is at http://backend:8000.

NODE_ENV=development
API_PROXY_TARGET=http://backend:8000

# Polling-based watch keeps HMR reliable on macOS bind mounts and SSHFS.
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true
