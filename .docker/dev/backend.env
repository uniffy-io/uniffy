# In-container host overrides for the dev compose stack.
# Layered ON TOP of repo-root .env: same key here wins.
# These point service hostnames at compose service names instead of localhost.

HOST=0.0.0.0

POSTGRES_HOST=postgres
POSTGRES_PORT=5432

VALKEY_HOST=valkey
VALKEY_PORT=6379

MEILISEARCH_URL=http://meilisearch:7700

S3_ENDPOINT_URL=http://rustfs:9000

# LiveKit:
# - LIVEKIT_HOST is server-to-server (backend -> LiveKit admin REST), use service name
# - LIVEKIT_WS_URL is what the BROWSER connects to, must stay localhost so it
#   resolves through SSH tunnel or local
LIVEKIT_HOST=http://livekit:7880
LIVEKIT_WS_URL=ws://localhost:7880

# Polling-based file watch keeps reload reliable on macOS bind mounts and
# over SSHFS / virtiofs inconsistencies.
WATCHFILES_FORCE_POLLING=1
