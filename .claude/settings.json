{
    "env": {
        "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
        "DISABLE_ERROR_REPORTING": "1",
        "DISABLE_TELEMETRY": "1"
    },
    "permissions": {
        "allow": [
            "Read(./**)",
            "Bash(ls:*)",
            "Bash(cat:*)",
            "Bash(grep:*)",
            "Bash(find:*)",
            "Bash(wc:*)",
            "Bash(tree:*)",
            "Bash(./manage.py:*)",
            "Bash(uv run manage.py:*)",
            "Bash(uv run ruff:*)",
            "Bash(pnpm run lint)",
            "Bash(pnpm lint:*)",
            "Bash(pnpm eslint:*)",
            "Bash(pnpm build:*)",
            "Bash(git checkout:*)",
            "Bash(git stash:*)",
            "Bash(git mv:*)",
            "Bash(gh pr:*)",
            "WebFetch(domain:milkdown.dev)",
            "WebFetch(domain:docs.anthropic.com)",
            "WebFetch(domain:connectrpc.com)",
            "WebFetch(domain:reactflow.dev)",
            "Edit(.claude/plans/**)",
            "Edit(.claude/plans/**)",
            "Edit(.claude/reviews/**)",
            "Edit(.claude/reviews/**)",
            "mcp__playwright__*"
        ],
        "deny": [
            "Read(.env)",
            "Read(.env.local)"
        ]
    },
    "enabledMcpjsonServers": [
        "playwright",
        "playwright-b"
    ]
}
