{
    "env": {
        "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
        "DISABLE_ERROR_REPORTING": "1",
        "DISABLE_TELEMETRY": "1"
    },
    "permissions": {
        "allow": [
            "Read(./**)",
            "Bash(ls:*)",
            "Bash(cat:*)",
            "Bash(grep:*)",
            "Bash(find:*)",
            "Bash(wc:*)",
            "Bash(tree:*)",
            "Bash(./manage.py:*)",
            "Bash(uv run manage.py:*)",
            "Bash(git checkout:*)",
            "Bash(git stash:*)",
            "Bash(git mv:*)",
            "Bash(gh pr:*)",
            "WebFetch(domain:milkdown.dev)",
            "WebFetch(domain:docs.anthropic.com)",
            "WebFetch(domain:connectrpc.com)",
            "WebFetch(domain:reactflow.dev)",
            "Edit(.agents/local/**)",
            "mcp__playwright__*",
            "mcp__playwright-b__*"
        ],
        "deny": [
            "Read(.env)",
            "Read(.env.local)"
        ]
    },
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "[ -f \"$CLAUDE_PROJECT_DIR/.agents/local/AGENTS.md\" ] && cat \"$CLAUDE_PROJECT_DIR/.agents/local/AGENTS.md\" || true"
                    }
                ]
            }
        ]
    },
    "enabledMcpjsonServers": [
        "playwright",
        "playwright-b"
    ]
}
