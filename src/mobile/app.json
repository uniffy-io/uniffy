{
  "expo": {
    "name": "Uniffy",
    "slug": "uniffy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/uniffy-logo.png",
    "scheme": "uniffy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/uniffy-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0E11"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.uniffy.app"
    },
    "android": {
      "package": "com.uniffy.app",
      "adaptiveIcon": {
        "backgroundColor": "#1A1B1E",
        "foregroundImage": "./assets/images/uniffy-logo.png"
      }
    },
    "web": {
      "favicon": "./assets/images/uniffy-logo.png"
    },
    "plugins": ["expo-router", "expo-font", "expo-web-browser", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
