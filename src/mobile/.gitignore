node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native - the prebuild output only. Leading slash anchors these to the package
# root: unanchored, they also swallow the hand-written native sources of local
# Expo modules under modules/*/android and modules/*/ios.
/ios/
/android/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
package-lock.json

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo
.vercel

# generated proto clients
gen/

.env
