    <div class="flex flex-col gap-2 border-t border-night-hairline px-5 py-4">
      <a
        href="https://cloud.uniffy.io/login"
        class="inline-flex items-center justify-center rounded-md border border-night-hairline px-4 py-2.5 font-mono text-[11px] font-bold uppercase tracking-wider text-night-text transition-colors hover:border-night-hairline-strong"
      >
        Sign in
      </a>
      <a
        href="https://cloud.uniffy.io/signup"
        class="inline-flex items-center justify-center gap-1.5 rounded-md bg-accent px-4 py-2.5 font-mono text-[11px] font-bold uppercase tracking-wider text-white transition-opacity hover:opacity-90"
      >
        Start free
        <span aria-hidden>&rarr;</span>
      </a>
    </div>
  </div>
</div>

<style>
  .site-header__beam {
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(105, 74, 255, 0) 12%,
      rgba(105, 74, 255, 0.6) 38%,
      rgba(253, 126, 234, 0.6) 62%,
      rgba(105, 74, 255, 0) 88%,
      transparent 100%
    );
    opacity: 0.4;
  }

  .nav-cell:hover .nav-cell__icon {
    border-color: var(--color-night-hairline-strong);
    color: var(--color-night-text);
  }
  .nav-cell:hover .nav-cell__label {
    color: var(--color-night-text);
  }

  .nav-cell.is-active .nav-cell__icon {
    border-color: rgba(105, 74, 255, 0.6);
    background: rgba(105, 74, 255, 0.12);
    color: var(--color-accent-strong);
  }
  .nav-cell.is-active .nav-cell__label {
    color: var(--color-night-text);
  }

  .cta__shimmer {
    transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .cta:hover .cta__shimmer {
    transform: translateX(100%);
  }

  .mobile-nav.is-open {
    display: block;
  }
  .mobile-nav.is-open .mobile-nav__panel {
    animation: mobile-nav-slide 240ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes mobile-nav-slide {
    from { transform: translateX(16px); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta__shimmer,
    .nav-cell__icon,
    .nav-cell__label,
    .mobile-nav__panel {
      transition: none;
      animation: none;
    }
  }
</style>

<script>
  function setupMobileMenu() {
    const nav = document.querySelector<HTMLElement>("[data-mobile-nav]");
    const toggles = document.querySelectorAll<HTMLElement>("[data-mobile-menu-toggle]");
    const closers = document.querySelectorAll<HTMLElement>("[data-mobile-menu-close]");
    const navLinks = document.querySelectorAll<HTMLAnchorElement>("[data-mobile-nav-link]");
    if (!nav) return;

    const open = () => {
      nav.classList.add("is-open");
      nav.setAttribute("aria-hidden", "false");
      toggles.forEach((t) => t.setAttribute("aria-expanded", "true"));
      document.documentElement.style.overflow = "hidden";
    };
    const close = () => {
      nav.classList.remove("is-open");
      nav.setAttribute("aria-hidden", "true");
      toggles.forEach((t) => t.setAttribute("aria-expanded", "false"));
      document.documentElement.style.overflow = "";
    };

    toggles.forEach((t) => t.addEventListener("click", open));
    closers.forEach((c) => c.addEventListener("click", close));
    navLinks.forEach((l) => l.addEventListener("click", close));

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && nav.classList.contains("is-open")) close();
    });
  }

  function setupScrollSpy() {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]"));
    const spyLinks = links.filter((l) => l.dataset.spy);
    if (spyLinks.length === 0) return;

    const sections = spyLinks
      .map((l) => {
        const id = l.dataset.spy!;
        const el = document.getElementById(id);
        return el ? { id, el, link: l } : null;
      })
      .filter((x): x is { id: string; el: HTMLElement; link: HTMLAnchorElement } => x !== null);

    const setActive = (id: string | null) => {
      for (const { link, id: linkId } of sections) {
        link.classList.toggle("is-active", linkId === id);
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
        if (visible.length > 0) {
          const top = visible[0].target.id;
          setActive(top);
        }
      },
      { rootMargin: "-40% 0px -50% 0px", threshold: [0, 0.25, 0.5, 0.75, 1] }
    );

    sections.forEach(({ el }) => observer.observe(el));
  }

  function boot() {
    setupMobileMenu();
    setupScrollSpy();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot, { once: true });
  } else {
    boot();
  }
</script>
