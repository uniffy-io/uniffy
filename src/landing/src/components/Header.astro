---
type NavLink = {
  href: string;
  label: string;
  icon: "mention" | "cpu" | "shield" | "compass" | "scales" | "tag" | "book";
  external?: boolean;
  spyId?: string;
  matchPrefix?: string;
};

const links: NavLink[] = [
  { href: "/#product", label: "Product", icon: "mention", spyId: "product" },
  { href: "/#ai", label: "AI", icon: "cpu", spyId: "ai" },
  { href: "/#sovereign", label: "Sovereign", icon: "shield", spyId: "sovereign" },
  { href: "/#principles", label: "Principles", icon: "compass", spyId: "principles" },
  { href: "/#compare", label: "Compare", icon: "scales", spyId: "compare" },
  { href: "/#pricing", label: "Pricing", icon: "tag", spyId: "pricing" },
  { href: "/docs/", label: "Docs", icon: "book", matchPrefix: "/docs/" },
];

const currentPath = Astro.url.pathname;
const isCurrent = (link: NavLink) =>
  link.matchPrefix !== undefined && currentPath.startsWith(link.matchPrefix);

interface Props {
  mobileExtraLabel?: string;
  mobileLinksMode?: "all" | "extra-only";
}
const { mobileExtraLabel, mobileLinksMode = "all" } = Astro.props;
const hasMobileExtra = Astro.slots.has("mobile-extra");
const showMobileMainLinks = mobileLinksMode === "all";
---

<a
  href="#main"
  class="skip-link sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-accent focus:px-4 focus:py-2 focus:font-mono focus:text-xs focus:font-bold focus:uppercase focus:tracking-wider focus:text-white"
>
  Skip to content
</a>

<header
  class="site-header sticky top-0 z-50 border-b border-night-hairline bg-night/80 backdrop-blur-xl"
  data-site-header
>
  <div class="site-header__beam pointer-events-none absolute inset-x-0 -bottom-px h-px"></div>

  <div class="flex h-14 items-center justify-between gap-4 px-4 md:px-6">
    <a href="/" class="brand group relative flex items-center gap-2 font-sans text-lg font-bold tracking-tight" aria-label="Uniffy home">
      <span class="brand__cell relative grid h-8 w-8 place-items-center overflow-hidden rounded-md border border-night-hairline transition-colors duration-300 group-hover:border-accent/60">
        <img
          src="/uniffy-glyph.png"
          alt=""
          width="24"
          height="24"
          class="h-5 w-5"
        />
      </span>
      <span class="brand__word relative text-night-text">Uniffy</span>
    </a>

    <nav class="hidden lg:flex items-center gap-0.5" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            data-nav-link
            data-spy={link.spyId ?? ""}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noreferrer" : undefined}
            aria-current={isCurrent(link) ? "page" : undefined}
            class:list={[
              "nav-cell group relative flex items-center gap-2 rounded-md px-2 py-1.5 transition-colors duration-200",
              isCurrent(link) && "is-active",
