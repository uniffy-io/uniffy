  </div>
</header>

<div
  id="mobile-nav"
  data-mobile-nav
  class="mobile-nav fixed inset-0 z-[55] hidden lg:hidden"
  aria-hidden="true"
>
  <div class="mobile-nav__scrim absolute inset-0 bg-night/80 backdrop-blur-md" data-mobile-menu-close></div>

  <div class="mobile-nav__panel relative ml-auto flex h-full w-full max-w-sm flex-col border-l border-night-hairline bg-night-soft shadow-2xl">
