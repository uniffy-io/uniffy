      >
        Sign in
      </a>
      <a
        href="https://cloud.uniffy.io/signup"
        class="cta group relative inline-flex items-center gap-1.5 overflow-hidden rounded-md bg-accent px-3.5 py-2 font-mono text-[11px] font-bold uppercase tracking-wider text-white transition-shadow duration-300 hover:shadow-[0_0_0_1px_rgba(105,74,255,0.7),0_8px_24px_-6px_rgba(105,74,255,0.6)]"
      >
        <span class="cta__shimmer pointer-events-none absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/60 to-transparent"></span>
        <span class="relative z-10">Start free</span>
        <span class="cta__arrow relative z-10 inline-block transition-transform duration-300 group-hover:translate-x-0.5" aria-hidden>&rarr;</span>
      </a>

      <button
        type="button"
        data-mobile-menu-toggle
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label="Open menu"
        class="mobile-toggle inline-grid h-9 w-9 place-items-center rounded-md border border-night-hairline text-night-muted transition-colors hover:border-night-hairline-strong hover:text-night-text lg:hidden"
