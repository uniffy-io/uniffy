      <article class="group relative overflow-hidden rounded-2xl border border-night-hairline bg-night-soft p-6 lg:col-span-4">
        <div class="flex items-center gap-2.5">
          <span class="grid h-9 w-9 shrink-0 place-items-center rounded-md border border-accent/55 bg-accent/10 text-accent">
