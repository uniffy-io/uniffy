            <svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor"><path d="M176 152a39.7 39.7 0 0 0-28.62 12.09l-46.1-29.63a39.8 39.8 0 0 0 0-12.92l46.1-29.63a40 40 0 1 0-8.66-13.45l-46.1 29.63a40 40 0 1 0 0 39.82l46.1 29.63A40 40 0 1 0 176 152Z"/></svg>
