              <div class="rounded border-l-2 border-emerald-500 bg-emerald-500/10 px-1 py-0.5 text-emerald-300">10:00 standup</div>
            </div>
            <div></div>
            <div class="space-y-1">
              <div class="rounded border-l-2 border-rose-500 bg-rose-500/10 px-1 py-0.5 text-rose-300">14:00 1:1 Teddy</div>
            </div>
            <div class="space-y-1">
              <div class="rounded border-l-2 border-violet-500 bg-violet-500/10 px-1 py-0.5 text-violet-300">10:00 review</div>
              <div class="rounded border-l-2 border-orange-500 bg-orange-500/10 px-1 py-0.5 text-orange-300">15:00 launch</div>
