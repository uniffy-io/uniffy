---
const pillars = [
  {
    tag: "BSL 1.1",
    title: "Source-available",
    body: "Every line of Uniffy is published under the Business Source License. Audit it, fork it for internal use, and on 2039-01-01 it becomes Apache 2.0.",
  },
  {
    tag: "Self-host",
    title: "Run on your own metal",
    body: "Docker, Kubernetes, on-prem, air-gapped. The same product as our cloud, no feature gating. Up to 10 users free, forever.",
  },
  {
    tag: "EU residency",
    title: "Data stays in Europe",
    body: "Our cloud runs in EU regions by default. GDPR-aligned. No transatlantic data exposure. No US Cloud Act surprises.",
  },
];
---

<section id="sovereign" class="section-separator-bottom bg-night-gradient px-5 py-16 sm:px-6 sm:py-20 md:px-10 md:py-32">
  <div class="mx-auto max-w-7xl">
    <h2 class="section-heading">
      Sovereign by default
    </h2>
    <p class="section-intro mt-6 max-w-3xl text-base leading-relaxed text-night-soft-text sm:text-lg">
      Your data, your servers, your call. Most workspace tools rent you access to
      their infrastructure. Uniffy publishes the source and lets you run the same
      product on your own hardware, in any region you choose. No feature gating
      between cloud and self-host.
    </p>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3 md:mt-16">
      {
        pillars.map((p) => (
          <article class="rounded-2xl border border-night-hairline bg-night-soft p-6 sm:p-8 md:p-10">
            <div class="inline-flex items-center rounded-full border border-night-hairline-strong bg-night px-2.5 py-1 font-mono text-xs text-night-text">
              {p.tag}
            </div>
            <h3 class="mt-6 font-sans text-2xl font-semibold tracking-tight text-night-text">{p.title}</h3>
            <p class="mt-3 leading-relaxed text-night-soft-text">{p.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
