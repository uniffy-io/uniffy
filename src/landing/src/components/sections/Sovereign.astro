---
const pillars = [
  {
    tag: "BSL 1.1",
    title: "Source-available",
    body: "Every line of Uniffy is published under the Business Source License. Audit it, fork it for internal use, and on 2039-01-01 it becomes Apache 2.0.",
  },
  {
    tag: "Self-host",
    title: "Run on your own metal",
    body: "Docker, Kubernetes, on-prem, air-gapped. The same product as our cloud, no feature gating. Up to 10 users free, forever.",
  },
  {
    tag: "EU residency",
    title: "Data stays in Europe",
    body: "Our cloud runs in EU regions by default. GDPR-aligned. No transatlantic data exposure. No US Cloud Act surprises.",
  },
];
---

<section id="sovereign" class="border-b border-night-hairline bg-night-band px-6 py-24 md:px-10 md:py-32">
  <div class="mx-auto max-w-7xl">
    <p class="mb-4 font-mono text-xs uppercase tracking-wider text-night-faint">
      Sovereign by default
    </p>
    <h2 class="max-w-5xl font-sans text-4xl font-semibold leading-[1.05] tracking-[-0.025em] text-night-text md:text-6xl">
      Your data. Your servers. <span class="text-night-muted">Your call.</span>
    </h2>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-night-soft-text">
      Notion, ClickUp, Monday, Airtable, Slack &mdash; none of them let you run their
      product yourself. We do. And we publish the source.
    </p>

    <div class="mt-16 grid gap-6 md:grid-cols-3">
      {
        pillars.map((p) => (
          <article class="rounded-2xl border border-night-hairline bg-night-soft p-8 md:p-10">
            <div class="inline-flex items-center rounded-full border border-night-hairline-strong bg-night px-2.5 py-1 font-mono text-xs text-night-text">
              {p.tag}
            </div>
            <h3 class="mt-6 font-sans text-2xl font-semibold tracking-tight text-night-text">{p.title}</h3>
            <p class="mt-3 leading-relaxed text-night-soft-text">{p.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
