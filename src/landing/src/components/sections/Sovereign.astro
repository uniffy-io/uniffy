---
const pillars = [
  {
    tag: "One license",
    title: "Open source, every line",
    body: "All of Uniffy ships under the Functional Source License. Read it, audit it, fork it, run it in production at any size for free. Every release becomes plain Apache 2.0 two years after we publish it. That grant is written into the license itself.",
  },
  {
    tag: "Self host",
    title: "Run on your own metal",
    body: "Docker, Kubernetes, your own racks, even fully isolated from the internet. The same product as our cloud, no feature gating. Free, no user limit, forever.",
  },
  {
    tag: "EU cloud",
    title: "Our hosted service stays in Europe",
    body: "This one is about the service we run for you. cloud.uniffy.io lives in EU regions, GDPR aligned, no transatlantic data exposure, no US Cloud Act surprises. Self host instead and the question never comes up. Your servers, your jurisdiction.",
  },
];
---

<section id="sovereign" class="section-separator-bottom bg-night-gradient px-5 py-16 sm:px-6 sm:py-20 md:px-10 md:py-32">
  <div class="mx-auto max-w-7xl">
    <h2 class="section-heading">
      Sovereign by default
    </h2>
    <p class="section-intro mt-6 max-w-3xl text-base leading-relaxed text-night-soft-text sm:text-lg">
      Your data, your servers, your call. Most workspace tools rent you access to
      their infrastructure. Uniffy is open source. Run the same product on your
      own hardware in any region you choose, or let us host it for you in the EU.
      No feature gating between cloud and self hosted.
    </p>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3 md:mt-16">
      {
        pillars.map((p) => (
          <article class="rounded-2xl border border-night-hairline bg-night-soft p-6 sm:p-8 md:p-10">
            <div class="inline-flex items-center rounded-full border border-night-hairline-strong bg-night px-2.5 py-1 font-mono text-xs text-night-text">
              {p.tag}
            </div>
            <h3 class="mt-6 font-sans text-2xl font-semibold tracking-tight text-night-text">{p.title}</h3>
            <p class="mt-3 leading-relaxed text-night-soft-text">{p.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
