---
const surfaces = [
  {
    name: "Notes",
    body: "Markdown wiki with bi-directional links, backlinks, and a graph view. Your second brain, sharable.",
    glyph: "N",
    accent: "bg-night-band text-night-text",
  },
  {
    name: "Chat",
    body: "Real-time channels and DMs. Drop notes, files, events into a thread without leaving the conversation.",
    glyph: "C",
    accent: "bg-violet-500/15 text-violet-300",
  },
  {
    name: "Files",
    body: "First-class file manager and previewer. Not an attachments folder &mdash; a full storage layer.",
    glyph: "F",
    accent: "bg-blue-500/15 text-blue-300",
  },
  {
    name: "Projects",
    body: "Tasks across board, table, graph, and roadmap views. Time tracking and Gantt timelines included.",
    glyph: "P",
    accent: "bg-emerald-500/15 text-emerald-300",
  },
  {
    name: "Calendar",
    body: "Native calendar in the workspace. Attach notes to meetings, link files to events, see it all in context.",
    glyph: "E",
    accent: "bg-rose-500/15 text-rose-300",
  },
  {
    name: "Spaces (AI)",
    body: "Group chat with a brain. Add knowledge, ask questions, get answers cited back to your own documents.",
    glyph: "@",
    accent: "bg-ink text-accent",
  },
];
---

<section class="border-b border-night-hairline bg-night px-6 py-24 md:px-10 md:py-32">
  <div class="mx-auto max-w-7xl">
    <p class="mb-4 font-mono text-xs uppercase tracking-wider text-night-faint">
      Six surfaces, one workspace
    </p>
    <h2 class="max-w-4xl font-sans text-4xl font-semibold leading-[1.05] tracking-[-0.025em] text-night-text md:text-6xl">
      Everything connects. <span class="text-night-muted">By design, not by integration.</span>
    </h2>

    <div class="mt-16 grid gap-px overflow-hidden rounded-2xl border border-night-hairline bg-night-hairline md:grid-cols-2 lg:grid-cols-3">
      {
        surfaces.map((s) => (
          <article class="bg-night-soft p-8 md:p-10">
            <div class={`mb-6 grid h-10 w-10 place-items-center rounded-lg font-mono text-base font-bold ${s.accent}`}>
              {s.glyph}
            </div>
            <h3 class="font-sans text-2xl font-semibold tracking-tight text-night-text">{s.name}</h3>
            <p class="mt-3 leading-relaxed text-night-soft-text" set:html={s.body} />
          </article>
        ))
      }
    </div>
  </div>
</section>
