---
const providers = [
  { name: "Anthropic", note: "Claude" },
  { name: "OpenAI", note: "GPT" },
  { name: "Google", note: "Gemini" },
  { name: "xAI", note: "Grok" },
  { name: "OpenRouter", note: "one key, many models" },
  { name: "Self hosted", note: "Ollama / vLLM / OpenAI-compatible", featured: true },
];

const pillars = [
  {
    kicker: "Many providers",
    title: "Any model, per agent",
    body: "Each agent picks its own provider and specific model. Run Claude Opus for planning, GPT-5 for code review, Gemini Flash for triage, a self hosted Llama for sensitive work. Side by side, in the same workspace, on the same data.",
  },
  {
    kicker: "Bound by permissions",
    title: "Agents inherit your access",
    body: "Every tool call runs as the asking user, through the same permission check the app itself runs. An agent cannot read what you cannot read, and a revoke lands on it in the same instant. Anything it cannot undo stops and asks you first. A scheduled run has nobody to ask, so it runs with the permissions of the person who owns the schedule and only theirs.",
  },
  {
    kicker: "Self hosted models",
    title: "No lab in the loop",
    body: "Don't trust the labs at all? Point Uniffy at your own Ollama or vLLM endpoint and run Llama, Mistral, Qwen, or DeepSeek on your own hardware. No outside lab touches your prompts. Nothing ever leaves your infrastructure.",
  },
];

const customisation = [
  {
    kicker: "Custom instructions",
    title: "Personality you write",
    body: "One free text block on every agent. It sets the tone, the constraints, and the house rules the agent carries into every conversation. A preview shows the fully assembled prompt, so you read exactly what the model reads.",
  },
  {
    kicker: "Tools",
    title: "The exact slice you allow",
    body: "Tools come in groups that map to the product. Notes, files, projects, tasks, calendar, rooms, people, search, images. A meeting agent that holds calendar and rooms cannot wander into files, even for someone who owns every file in the org.",
  },
  {
    kicker: "Skills",
    title: "Procedures, not prompt bloat",
    body: "Short markdown procedures an agent pulls in when they apply. Four ship with Uniffy, your org writes the rest, and every edit is versioned so you can compare and roll back. A thumbs down on an answer turns into a draft skill for review.",
  },
  {
    kicker: "Memory",
    title: "Facts that persist",
    body: "You get one memory store that every agent you talk to shares, and you can read, pin and delete all of it. Your org has its own, separate. What an agent learns in a channel stays with the channel.",
  },
  {
    kicker: "Automations",
    title: "Work that happens without you",
    body: "Put an agent on a schedule and the Monday digest writes itself. A scheduled run executes as the person who owns it, so an automation can never become a way to run a prompt as a colleague with more access than you.",
  },
  {
    kicker: "Budgets and limits",
    title: "Spend you can actually see",
    body: "Org budgets, per member quotas, and per minute rate limits on messages and image generation. Alerts on the way up, hard stops if you want them, and usage broken down by agent, model and key.",
  },
];

type ToolCallStatus = "ok" | "denied" | "pending";
type ToolCallLine = { name: string; status: ToolCallStatus; detail?: string };

type DemoLine =
  | { kind: "user"; sender: string; initials: string; avatarColor: string; time: string; text: string }
  | { kind: "agent"; sender: string; time: string; text: string; toolCalls?: ToolCallLine[]; cite?: string }
  | { kind: "approval"; sender: string; time: string; text: string; action: string };

const demo: DemoLine[] = [
  {
    kind: "user",
    sender: "Teddy Ivanova",
    initials: "TI",
    avatarColor: "bg-emerald-500",
    time: "11:02",
    text: "What's left in the agent runtime work? Pull the latest plan and the open tasks.",
  },
  {
    kind: "agent",
    sender: "EngineeringAgent",
    time: "11:02",
    toolCalls: [
      { name: "notes.read_note", status: "ok", detail: "Roadmap Q3 2026" },
      { name: "tasks.list_tasks", status: "ok", detail: "project: AGT-12 · 3 open" },
      { name: "files.read_file_content", status: "denied", detail: "Budget 2026.xlsx · no access" },
    ],
    text: "Egress retries are done and deploying. Two tasks remain. DLQ wiring and the metrics dashboard are still open. I went for the budget breakdown too, but it is private to its owner and you have no access to it, so neither do I.",
    cite: "Roadmap Q3 2026",
  },
  {
    kind: "user",
    sender: "Teddy Ivanova",
    initials: "TI",
    avatarColor: "bg-emerald-500",
    time: "11:03",
    text: "Mark the retries task done and bin the old runtime draft.",
  },
  {
    kind: "agent",
    sender: "EngineeringAgent",
    time: "11:03",
    toolCalls: [{ name: "tasks.update_task", status: "ok", detail: "Wire up egress worker retries · Done" }],
    text: "Task closed. The note is a different matter, deleting it cannot be undone.",
  },
  {
    kind: "approval",
    sender: "EngineeringAgent",
    time: "11:03",
    text: "About to delete Agent runtime draft v1. This cannot be undone. Approve to proceed?",
    action: "notes.delete_note",
  },
];
---

<section id="ai" class="section-separator-bottom bg-night-gradient px-5 py-16 sm:px-6 sm:py-20 md:px-10 md:py-32">
  <div class="mx-auto max-w-7xl">
    <h2 class="section-heading">
      AI on your terms
    </h2>
    <p class="section-intro mt-6 max-w-3xl text-base leading-relaxed text-night-soft-text sm:text-lg">
      Uniffy's AI is an <span class="text-accent-strong">agent harness</span> for work.
      Agents read, write, schedule, and organize across the whole workspace, and
      none of it runs until your org switches it on. Choose the model that fits
      the task. Bring your own provider credentials, or connect a self hosted
      endpoint and keep every prompt on your own hardware. Whatever
      you pick, every tool call the agent makes is checked against the same
      permission system that protects the rest of your workspace. An agent only
      ever sees what the user asking it is allowed to see.
    </p>
    <p class="mt-4 max-w-3xl text-base leading-relaxed text-night-soft-text sm:text-lg">
      One carve out, stated plainly. When an agent calls a service you connected,
      GitHub for example, it uses that connection's own credential. Its reach
      there is whatever that credential can reach, and it is the same for every
      member who asks. The GitHub tools we ship today only read, and an admin
      has to turn writing on before any integration can write at all.
    </p>

    <div class="mt-10 flex flex-col gap-3 font-mono text-xs md:flex-row md:flex-wrap md:items-center md:gap-2">
      <span class="text-night-faint">Supported providers:</span>
      <div class="flex flex-wrap gap-2 md:contents">
      {providers.map((p) => (
        <span class={`inline-flex items-center gap-1.5 rounded-full border px-3 py-1 ${p.featured ? "border-accent/40 bg-accent/10 text-accent-strong" : "border-night-hairline bg-night-soft text-night-soft-text"}`}>
          <span>{p.name}</span>
          <span class={p.featured ? "text-accent-strong/70" : "text-night-faint"}>&middot; {p.note}</span>
        </span>
      ))}
      </div>
    </div>

    <div class="mt-12 grid gap-5 sm:gap-6 lg:grid-cols-2 lg:items-stretch md:mt-16">
    <div class="flex h-full flex-col overflow-hidden rounded-2xl border border-night-hairline bg-night-soft shadow-2xl shadow-black/40">
      <div class="flex items-center justify-between border-b border-night-hairline bg-night-band px-5 py-3">
        <div class="flex items-center gap-2.5">
          <span class="grid h-9 w-9 shrink-0 place-items-center rounded-md border border-accent/55 bg-accent/10 text-accent-strong">
            <svg width="18" height="18" viewBox="0 0 256 256" fill="currentColor"><path d="M200 48h-64V16a8 8 0 0 0-16 0v32H56a32 32 0 0 0-32 32v112a32 32 0 0 0 32 32h144a32 32 0 0 0 32-32V80a32 32 0 0 0-32-32Zm-96 88a16 16 0 1 1 16-16 16 16 0 0 1-16 16Zm84 32H68a4 4 0 0 1 0-8h120a4 4 0 0 1 0 8Zm-4-32a16 16 0 1 1 16-16 16 16 0 0 1-16 16Z"/></svg>
          </span>
          <div class="leading-tight">
            <div class="flex items-center gap-2">
              <p class="text-sm font-semibold text-night-text">EngineeringAgent</p>
              <span class="inline-flex items-center gap-1 rounded-md bg-cyan-500/10 px-1.5 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-wider text-cyan-400">
                Agent
              </span>
            </div>
            <p class="font-mono text-[11px] text-night-faint">Claude Opus 4.7 &middot; Anthropic &middot; 9 tools enabled</p>
          </div>
        </div>
        <div class="hidden items-center gap-3 font-mono text-[11px] text-night-faint sm:flex">
          <span class="inline-flex items-center gap-1.5">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            running
          </span>
          <span>access: viewer</span>
        </div>
      </div>

      <div class="divide-y divide-night-hairline/60">
        {demo.map((line) => {
          if (line.kind === "user") {
            return (
              <div class="flex gap-3 px-5 py-4 md:px-6">
                <span class={`mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-full text-xs font-semibold text-white shadow-sm ${line.avatarColor}`}>
                  {line.initials}
                </span>
                <div class="min-w-0 flex-1">
                  <div class="flex items-baseline gap-2">
                    <span class="text-sm font-semibold text-night-text">{line.sender}</span>
                    <span class="font-mono text-[11px] text-night-faint">{line.time}</span>
                  </div>
                  <p class="mt-1 text-sm leading-relaxed text-night-soft-text">{line.text}</p>
                </div>
              </div>
            );
          }
          if (line.kind === "agent") {
            return (
              <div class="flex gap-3 px-5 py-4 md:px-6">
                <span class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-md border border-accent/55 bg-accent/10 text-accent-strong">
                  <svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor"><path d="M200 48h-64V16a8 8 0 0 0-16 0v32H56a32 32 0 0 0-32 32v112a32 32 0 0 0 32 32h144a32 32 0 0 0 32-32V80a32 32 0 0 0-32-32Zm-96 88a16 16 0 1 1 16-16 16 16 0 0 1-16 16Zm84 32H68a4 4 0 0 1 0-8h120a4 4 0 0 1 0 8Zm-4-32a16 16 0 1 1 16-16 16 16 0 0 1-16 16Z"/></svg>
                </span>
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-2">
                    <span class="text-sm font-semibold text-night-text">{line.sender}</span>
                    <span class="inline-flex items-center gap-1 rounded-md bg-cyan-500/10 px-1.5 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-wider text-cyan-400">
                      via Agent
                    </span>
                    <span class="font-mono text-[11px] text-night-faint">{line.time}</span>
                  </div>
                  {line.toolCalls && line.toolCalls.length > 0 && (
                    <div class="mt-2 flex flex-wrap gap-1.5">
                      {line.toolCalls.map((tc) => (
                        <span class={`inline-flex items-center gap-1.5 rounded-md border px-2 py-1 font-mono text-[11px] ${
                          tc.status === "ok"
                            ? "border-emerald-500/30 bg-emerald-500/10 text-emerald-400"
                            : tc.status === "denied"
                              ? "border-rose-500/30 bg-rose-500/10 text-rose-400"
                              : "border-amber-500/30 bg-amber-500/10 text-amber-400"
                        }`}>
                          {tc.status === "ok" && (
                            <svg width="10" height="10" viewBox="0 0 256 256" fill="currentColor"><path d="M229.66 77.66 105.66 201.66a8 8 0 0 1-11.32 0l-56-56a8 8 0 0 1 11.32-11.32L100 184.69 218.34 66.34a8 8 0 0 1 11.32 11.32Z"/></svg>
                          )}
                          {tc.status === "denied" && (
                            <svg width="10" height="10" viewBox="0 0 256 256" fill="currentColor"><path d="M208.49 191.51a12 12 0 0 1-17 17L128 145l-63.51 63.49a12 12 0 0 1-17-17L111 128 47.51 64.49a12 12 0 0 1 17-17L128 111l63.51-63.51a12 12 0 0 1 17 17L145 128Z"/></svg>
                          )}
                          <span>{tc.name}</span>
                          {tc.detail && (
                            <>
                              <span class="opacity-50">&middot;</span>
                              <span class="opacity-80">{tc.detail}</span>
                            </>
                          )}
                        </span>
                      ))}
                    </div>
                  )}
                  <p class="mt-2 text-sm leading-relaxed text-night-soft-text">{line.text}</p>
                  {line.cite && (
                    <div class="mt-2 inline-flex items-center gap-1.5 rounded-md border border-night-hairline bg-night px-2 py-1 font-mono text-[11px] text-night-soft-text">
                      <svg width="10" height="10" viewBox="0 0 256 256" fill="currentColor" class="text-violet-400"><path d="M227.32 73.37 182.63 28.69a16 16 0 0 0-22.63 0L36.69 152a15.86 15.86 0 0 0-4.69 11.31V208a16 16 0 0 0 16 16h44.69a15.86 15.86 0 0 0 11.31-4.69L227.32 96a16 16 0 0 0 0-22.63ZM92.69 208H48v-44.69l88-88L180.69 120ZM192 108.69 147.32 64l24-24L216 84.69Z"/></svg>
                      <span>cited: {line.cite}</span>
                    </div>
                  )}
                </div>
              </div>
            );
          }
          return (
            <div class="flex gap-3 px-5 py-4 md:px-6">
              <span class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-md border border-accent/55 bg-accent/10 text-accent-strong">
                <svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor"><path d="M200 48h-64V16a8 8 0 0 0-16 0v32H56a32 32 0 0 0-32 32v112a32 32 0 0 0 32 32h144a32 32 0 0 0 32-32V80a32 32 0 0 0-32-32Zm-96 88a16 16 0 1 1 16-16 16 16 0 0 1-16 16Zm84 32H68a4 4 0 0 1 0-8h120a4 4 0 0 1 0 8Zm-4-32a16 16 0 1 1 16-16 16 16 0 0 1-16 16Z"/></svg>
              </span>
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-semibold text-night-text">{line.sender}</span>
                  <span class="inline-flex items-center gap-1 rounded-md bg-amber-500/10 px-1.5 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-wider text-amber-400">
                    approval needed
                  </span>
                  <span class="font-mono text-[11px] text-night-faint">{line.time}</span>
                </div>
                <p class="mt-2 text-sm leading-relaxed text-night-soft-text">{line.text}</p>
                <div class="mt-3 flex flex-wrap items-center gap-2">
                  <span class="inline-flex items-center gap-1.5 rounded-md border border-amber-500/30 bg-amber-500/10 px-2 py-1 font-mono text-[11px] text-amber-400">
                    <svg width="10" height="10" viewBox="0 0 256 256" fill="currentColor"><path d="M240.26 186.1 152.81 34.23a28.74 28.74 0 0 0-49.62 0L15.74 186.1a27.45 27.45 0 0 0 0 27.71A28.31 28.31 0 0 0 40.55 228h174.9a28.31 28.31 0 0 0 24.79-14.19a27.45 27.45 0 0 0 .02-27.71Z"/></svg>
                    {line.action}
                  </span>
                  <button class="inline-flex items-center gap-1.5 rounded-md bg-accent px-3 py-1 font-mono text-[11px] font-semibold text-white hover:opacity-90">
                    Approve
                  </button>
                  <button class="inline-flex items-center gap-1.5 rounded-md border border-night-hairline-strong bg-night px-3 py-1 font-mono text-[11px] text-night-soft-text hover:border-night-text">
                    Reject
                  </button>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <div class="flex flex-wrap items-center justify-between gap-3 border-t border-night-hairline bg-night-band px-5 py-3 font-mono text-[11px] text-night-faint">
        <span>tool calls gated by your role &middot; deletes need your approval in chat</span>
        <span class="hidden sm:inline">9 tools enabled &middot; 4 skills active &middot; 12 memories</span>
      </div>
    </div>

    <div class="flex h-full flex-col overflow-hidden rounded-2xl border border-night-hairline bg-night-soft shadow-2xl shadow-black/40">
      <div class="flex items-center justify-between border-b border-night-hairline bg-night-band px-5 py-3">
        <div class="flex items-center gap-2.5">
          <span class="grid h-9 w-9 shrink-0 place-items-center rounded-md bg-night text-night-soft-text">
            <svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor"><path d="M128 80a48 48 0 1 0 48 48a48.05 48.05 0 0 0-48-48Zm0 80a32 32 0 1 1 32-32a32 32 0 0 1-32 32Zm88-29.84q.06-2.16 0-4.32l14.92-18.64a8 8 0 0 0 1.48-7.06a107.6 107.6 0 0 0-10.88-26.25a8 8 0 0 0-6-3.93l-23.72-2.64q-1.48-1.56-3-3L186 40.54a8 8 0 0 0-3.94-6a107.29 107.29 0 0 0-26.25-10.86a8 8 0 0 0-7.06 1.48l-18.64 14.92q-2.16-.06-4.32 0L107.16 25.2a8 8 0 0 0-7.06-1.48A107.6 107.6 0 0 0 73.85 34.6a8 8 0 0 0-3.93 6l-2.64 23.72q-1.56 1.49-3 3L40.54 70a8 8 0 0 0-6 3.94a107.71 107.71 0 0 0-10.87 26.25a8 8 0 0 0 1.49 7.06l14.92 18.64q-.06 2.16 0 4.32L25.2 148.84a8 8 0 0 0-1.48 7.06a107.6 107.6 0 0 0 10.88 26.25a8 8 0 0 0 6 3.93l23.72 2.64q1.49 1.56 3 3L70 215.46a8 8 0 0 0 3.94 6a107.71 107.71 0 0 0 26.25 10.87a8 8 0 0 0 7.06-1.49l18.64-14.92q2.16.06 4.32 0l18.64 14.92a8 8 0 0 0 7.06 1.48a107.21 107.21 0 0 0 26.25-10.88a8 8 0 0 0 3.93-6l2.64-23.72q1.56-1.48 3-3l23.72-2.64a8 8 0 0 0 6-3.94a107.71 107.71 0 0 0 10.87-26.25a8 8 0 0 0-1.49-7.06Z"/></svg>
          </span>
          <div class="leading-tight">
            <p class="text-sm font-semibold text-night-text">Configure agent</p>
            <p class="font-mono text-[11px] text-night-faint">EngineeringAgent &middot; saved 2m ago</p>
          </div>
        </div>
        <span class="hidden font-mono text-[11px] text-accent sm:inline">Edit</span>
      </div>

      <div class="flex-1 divide-y divide-night-hairline/60">
        <div class="px-5 py-4 md:px-6">
          <p class="font-mono text-[10px] uppercase tracking-wider text-night-faint">Model</p>
          <div class="mt-2 flex items-center justify-between rounded-md border border-night-hairline bg-night px-3 py-2">
            <div class="flex items-center gap-2">
              <span class="inline-flex h-5 w-5 items-center justify-center rounded bg-cyan-500/15 font-mono text-[10px] font-bold text-cyan-400">A</span>
              <span class="font-mono text-xs text-night-text">Claude Opus 4.7</span>
            </div>
            <div class="flex items-center gap-2 font-mono text-[11px] text-night-faint">
              <span>Anthropic</span>
              <svg width="10" height="10" viewBox="0 0 256 256" fill="currentColor"><path d="m213.66 101.66-80 80a8 8 0 0 1-11.32 0l-80-80a8 8 0 0 1 11.32-11.32L128 164.69l74.34-74.35a8 8 0 0 1 11.32 11.32Z"/></svg>
            </div>
          </div>
          <div class="mt-2 flex flex-wrap gap-1.5 font-mono text-[10px] text-night-faint">
            <span class="rounded-full border border-night-hairline px-2 py-0.5">fallback: Claude Sonnet 4.6</span>
            <span class="rounded-full border border-night-hairline px-2 py-0.5">1M context</span>
            <span class="rounded-full border border-night-hairline px-2 py-0.5">reasoning: high</span>
          </div>
        </div>

        <div class="px-5 py-4 md:px-6">
          <div class="flex items-center justify-between">
            <p class="font-mono text-[10px] uppercase tracking-wider text-night-faint">Tools <span class="text-night-soft-text">(9 enabled)</span></p>
            <span class="font-mono text-[10px] text-accent-strong">browse all</span>
          </div>
          <ul class="mt-2 space-y-1.5">
            <li class="flex items-center justify-between rounded-md bg-night/40 px-3 py-1.5">
              <span class="font-mono text-[11px] text-night-soft-text">notes.read_note</span>
              <span class="inline-flex items-center gap-1 font-mono text-[10px] text-emerald-400">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                enabled
              </span>
            </li>
            <li class="flex items-center justify-between rounded-md bg-night/40 px-3 py-1.5">
              <span class="font-mono text-[11px] text-night-soft-text">tasks.list_tasks</span>
              <span class="inline-flex items-center gap-1 font-mono text-[10px] text-emerald-400">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                enabled
              </span>
            </li>
            <li class="flex items-center justify-between rounded-md bg-night/40 px-3 py-1.5">
              <span class="font-mono text-[11px] text-night-soft-text">tasks.update_task</span>
              <span class="inline-flex items-center gap-1 font-mono text-[10px] text-emerald-400">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                enabled
              </span>
            </li>
            <li class="flex items-center justify-between rounded-md bg-night/40 px-3 py-1.5">
              <span class="font-mono text-[11px] text-night-soft-text">notes.delete_note</span>
              <span class="inline-flex items-center gap-1 font-mono text-[10px] text-amber-400">
                <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
                approval required
              </span>
            </li>
            <li class="flex items-center justify-between rounded-md bg-night/40 px-3 py-1.5">
              <span class="font-mono text-[11px] text-night-faint">files.read_file_content</span>
              <span class="inline-flex items-center gap-1 font-mono text-[10px] text-night-faint">
                <span class="h-1.5 w-1.5 rounded-full bg-night-faint"></span>
                off
              </span>
            </li>
          </ul>
        </div>

        <div class="px-5 py-4 md:px-6">
          <p class="font-mono text-[10px] uppercase tracking-wider text-night-faint">Permissions</p>
          <div class="mt-2 grid gap-2 text-xs sm:grid-cols-2">
            <div class="rounded-md border border-night-hairline bg-night px-3 py-2">
              <p class="font-mono text-[10px] uppercase tracking-wider text-night-faint">Who can use it</p>
              <p class="mt-1 font-mono text-night-text">Everyone in org</p>
              <p class="mt-1 font-mono text-[10px] text-night-faint">starting role: viewer</p>
            </div>
            <div class="rounded-md border border-night-hairline bg-night px-3 py-2">
              <p class="font-mono text-[10px] uppercase tracking-wider text-night-faint">Explicit grants</p>
              <p class="mt-1 font-mono text-night-text">2 users &middot; 1 group</p>
              <p class="mt-1 font-mono text-[10px] text-night-faint">Teddy (admin), Georgi (editor), @engineering</p>
            </div>
          </div>
        </div>

