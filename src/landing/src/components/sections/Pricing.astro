---
type Tier = {
  name: string;
  price: string;
  cadence: string;
  blurb: string;
  blurbHighlight?: string;
  ai: string;
  features: string[];
  cta: { label: string; href: string };
  featured: boolean;
};

const tiers: Tier[] = [
  {
    name: "Community",
    price: "Free",
    cadence: "forever",
    blurb: "Up to 10 users. Self host or cloud. ",
    blurbHighlight: "The full product, no feature gating.",
    ai: "bring your own provider key",
    features: [
      "Self host or cloud",
      "Uniffy AI Cloud · 1M tokens / month free",
      "Bring your own AI provider keys",
      "Notes, Chat, Files, Calendar, Projects, Tasks, Diagrams, Rooms",
      "Universal @ mentions across everything",
      "Configurable agents with permission bound tool calling",
      "Unlimited history when self hosted",
      "Community support",
    ],
    cta: { label: "Start free", href: "https://cloud.uniffy.io/signup" },
    featured: false,
  },
  {
    name: "Team",
    price: "€7",
    cadence: "user / month",
    blurb: "For teams of 11 to 50. Same software, more seats and more service.",
    ai: "Uniffy AI Cloud included",
    features: [
      "Everything in Community, because everything is in Community",
      "Uniffy AI Cloud · 10M tokens / user / month",
      "Unlimited cloud history",
      "Email support",
    ],
    cta: { label: "Start trial", href: "https://cloud.uniffy.io/signup" },
    featured: true,
  },
  {
    name: "Business",
    price: "€15",
    cadence: "user / month",
    blurb: "For organizations up to 500. Service levels for companies that need paper.",
    ai: "Uniffy AI Cloud included",
    features: [
      "Everything in Team",
      "Uniffy AI Cloud · 30M tokens / user / month",
      "99.2% uptime SLA on cloud",
      "Priority support",
    ],
    cta: { label: "Contact sales", href: "/contact" },
    featured: false,
  },
  {
    name: "Enterprise",
    price: "Custom",
    cadence: "annual",
    blurb: "Unlimited seats, custom contracts, dedicated people on our side.",
    ai: "self hosted models + dedicated routing",
    features: [
      "Everything in Business",
      "Uniffy AI Cloud · pooled, custom token limits",
      "Data residency of your choice",
      "Self hosted models + dedicated routing",
      "Dedicated support + 99.98% SLA",
      "Custom contracts",
    ],
    cta: { label: "Talk to us", href: "/contact" },
    featured: false,
  },
];
---

<section id="pricing" class="bg-night-gradient px-5 py-16 sm:px-6 sm:py-20 md:px-10 md:py-32">
  <div class="mx-auto max-w-7xl">
    <h2 class="section-heading">
      Honest pricing
    </h2>
    <p class="section-intro mt-6 max-w-3xl text-base leading-relaxed text-night-soft-text sm:text-lg">
      Every plan runs the same software. Tiers price seats, hosted services, and support.
      Never features. Free for up to 10 users, forever, self hosted or on our cloud.
      No AI surcharge, ever. Use your own keys, Uniffy AI Cloud, or a self hosted model.
    </p>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 sm:gap-6 lg:grid-cols-4 md:mt-16">
      {tiers.map((t) => (
        <article
          class={`flex flex-col rounded-2xl border p-6 sm:p-7 lg:p-8 ${t.featured ? "border-accent bg-night-band text-night-text" : "border-night-hairline bg-night-soft text-night-text"}`}
        >
          <h3 class="font-sans text-xl font-semibold tracking-tight">{t.name}</h3>
          <div class="mt-5 flex items-baseline gap-2 md:mt-6">
            <span class="font-sans text-4xl font-semibold tracking-[-0.03em] sm:text-5xl">
              {t.price}
            </span>
            <span class={`font-mono text-xs ${t.featured ? "text-night-muted" : "text-night-faint"}`}>
              {t.cadence}
            </span>
          </div>
          <p class="mt-4 min-h-[3.5rem] text-sm leading-relaxed text-night-soft-text">
            {t.blurb}
            {t.blurbHighlight && (
              <span class="font-semibold text-accent-strong">{t.blurbHighlight}</span>
            )}
          </p>

          <ul class="mt-6 flex-1 space-y-2.5 text-sm">
            <li class="flex items-start gap-2">
              <span class="mt-1.5 h-1 w-2.5 flex-shrink-0 bg-accent" />
              <span class="font-semibold text-accent-strong">Native AI with controlled access</span>
            </li>
            {t.features.map((f) => (
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-1 w-2.5 flex-shrink-0 bg-accent" />
                <span class="font-medium text-night-soft-text">{f}</span>
              </li>
            ))}
          </ul>
          <a
            href={t.cta.href}
            class={`mt-8 inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-medium transition-opacity ${
              t.featured
                ? "bg-accent text-white hover:opacity-90"
                : "border border-night-hairline-strong bg-night-soft text-night-text hover:border-night-text"
            }`}
          >
            {t.cta.label}
            <span aria-hidden>&rarr;</span>
          </a>
        </article>
      ))}
    </div>

    <p class="mt-10 max-w-3xl text-sm leading-relaxed text-night-soft-text md:mt-12">
      SSO, SCIM, guests, custom branding, retention policies, the audit log, every agent
      feature. Those are product features, so they are in every plan, including the free one.
      A license key changes one number, the seat count. It is a signed file your deployment
      verifies offline. There is no license server and your instance never calls home.
      <a href="/docs/deployment/licensing/" class="font-medium text-accent-strong hover:underline"
        >Read how licensing works</a
      >.
    </p>
  </div>
</section>
