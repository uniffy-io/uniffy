---
import Default from "@astrojs/starlight/components/Sidebar.astro";
import Search from "@astrojs/starlight/components/Search.astro";
---

<div class="docs-sidebar-search">
  <Search {...Astro.props} />
</div>

<Default {...Astro.props}><slot /></Default>

<style is:global>
  .docs-sidebar-search {
    padding: 0 0 0.75rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }
  .docs-sidebar-search site-search button[data-open-modal] {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.5rem 0.65rem;
    background: var(--sl-color-bg-inline-code);
    border: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-2);
    border-radius: 0.375rem;
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    text-transform: none;
    letter-spacing: 0;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .docs-sidebar-search site-search button[data-open-modal]:hover {
    border-color: var(--sl-color-hairline-light);
    color: var(--sl-color-text);
  }
  .docs-sidebar-search site-search button[data-open-modal] kbd {
    margin-left: auto;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-3);
    padding: 0.05rem 0.3rem;
    border-radius: 0.25rem;
    font-size: 0.65rem;
    font-family: var(--sl-font-mono);
  }
  .docs-sidebar-search site-search button[data-open-modal] kbd + kbd {
    margin-left: 0.15rem;
  }
</style>
