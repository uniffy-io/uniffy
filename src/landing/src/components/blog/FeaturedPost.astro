---
import AuthorLine from "@/components/blog/AuthorLine.astro";
import BlogCover from "@/components/blog/BlogCover.astro";
import TagChip from "@/components/blog/TagChip.astro";
import { accentFor, authorOf, formatDate, postUrl, readingMinutes, type Post } from "@/lib/blog";

interface Props {
  post: Post;
  number: string;
}

const { post, number } = Astro.props;
const accent = accentFor(post);
const author = authorOf(post);
const url = postUrl(post);
const minutes = readingMinutes(post.body);
---

<article class="featured group relative grid gap-5 overflow-hidden rounded-3xl border border-night-hairline bg-night-soft p-3 transition-[border-color,box-shadow] duration-500 hover:border-night-hairline-strong hover:shadow-[0_40px_80px_-40px_rgba(0,0,0,0.9)] sm:p-4 lg:grid-cols-[1.15fr_1fr] lg:gap-8 lg:p-5">
  <div class="overflow-hidden rounded-2xl border border-night-hairline">
    <BlogCover
      class="aspect-[16/10] h-full lg:aspect-auto lg:min-h-[24rem]"
      seed={post.id}
      accent={accent}
      number={number}
      cover={post.data.cover}
      coverAlt={post.data.coverAlt}
      sizes="(min-width: 1024px) 55vw, 100vw"
      eager
    />
  </div>

  <div class="flex flex-col justify-center px-2 pb-3 sm:px-4 lg:py-6 lg:pr-8">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-[11px] uppercase tracking-[0.12em] text-night-faint">
      <span class="text-accent-strong">Latest</span>
      <span aria-hidden="true">&middot;</span>
      {post.data.tags.slice(0, 2).map((tag) => <TagChip tag={tag} />)}
      <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
      {post.data.draft && <span class="text-brand-orange">Draft</span>}
    </div>

    <h2 class="mt-5 font-sans text-3xl font-semibold leading-[1.1] tracking-[-0.025em] text-night-text text-balance sm:text-4xl lg:text-[2.6rem]">
      <a href={url} class="featured__link">{post.data.title}</a>
    </h2>

    <p class="mt-5 max-w-xl text-base leading-relaxed text-night-soft-text sm:text-lg">{post.data.description}</p>

    <div class="mt-7 flex flex-wrap items-center justify-between gap-4 border-t border-night-hairline/70 pt-5">
      <AuthorLine author={author} accentHex={accent.hex} meta={`${minutes} min read`} />
      <span class="inline-flex items-center gap-2 font-mono text-[11px] font-bold uppercase tracking-wider text-accent-strong">
        Read the post
        <svg viewBox="0 0 256 256" class="featured__arrow h-3.5 w-3.5 transition-transform duration-300" fill="currentColor" aria-hidden="true">
          <path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z" />
        </svg>
      </span>
    </div>
  </div>
</article>

<style>
  .featured__link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .featured__link:focus-visible {
    outline: none;
  }
  .featured__link:focus-visible::after {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
    border-radius: 1.5rem;
  }
  .featured:hover .featured__arrow {
    transform: translateX(3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .featured,
    .featured__arrow {
      transition: none;
    }
  }
</style>
