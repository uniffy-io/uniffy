---
type FooterLink = { href: string; label: string; external?: boolean };

const columns: { title: string; links: FooterLink[] }[] = [
  {
    title: "Product",
    links: [
      { href: "/#product", label: "Overview" },
      { href: "/#ai", label: "AI" },
      { href: "/#sovereign", label: "Self host" },
      { href: "/#pricing", label: "Pricing" },
      { href: "/cloud", label: "Cloud" },
    ],
  },
  {
    title: "Open source",
    links: [
      { href: "https://github.com/uniffy-io/uniffy", label: "GitHub", external: true },
      { href: "https://github.com/uniffy-io/uniffy/issues", label: "Issues", external: true },
      { href: "/docs/deployment/licensing/", label: "Licensing" },
      { href: "/docs/legal/licenses/", label: "Third party licenses" },
      { href: "/docs/principles/", label: "Transparency" },
    ],
  },
  {
    title: "Resources",
    links: [
      { href: "/docs/", label: "Docs" },
      { href: "/faq", label: "FAQ" },
      { href: "https://feedback.uniffy.io", label: "Feedback", external: true },
      { href: "https://status.uniffy.io", label: "Status", external: true },
    ],
  },
  {
    title: "Company",
    links: [
      { href: "/contact", label: "Contact" },
      { href: "/terms", label: "Terms of Service" },
      { href: "/privacy", label: "Privacy Policy" },
      { href: "/docs/legal/trademarks/", label: "Trademarks" },
    ],
  },
];
---

<footer class="border-t border-night-hairline bg-night-soft">
  <div class="mx-auto max-w-7xl px-6 py-16 md:px-10">
    <div class="grid gap-12 md:grid-cols-[1.6fr_1fr_1fr_1fr_1fr]">
      <div>
        <a href="/" class="flex items-center gap-2.5 font-sans text-lg font-bold tracking-tight">
          <img
            src="/uniffy-glyph.png"
            alt="Uniffy"
            width="28"
            height="28"
            class="h-7 w-7"
          />
          <span class="text-night-text">Uniffy</span>
        </a>
        <p class="mt-4 font-mono text-xs leading-relaxed text-night-faint">
          Free to self host,<br />no user limit, forever.
        </p>
      </div>
      {
        columns.map((col) => (
          <div>
            <h4 class="text-xs font-medium uppercase tracking-wider text-night-faint">
              {col.title}
            </h4>
            <ul class="mt-4 space-y-3">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noreferrer" : undefined}
                    class="text-sm text-night-soft-text transition-colors hover:text-night-text"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="mt-16 flex flex-col gap-4 border-t border-night-hairline pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-mono text-xs text-night-faint">
        &copy; 2026 Uniffy Labs. Open source, one license for every line.
      </p>
      <nav class="flex items-center gap-4 font-mono text-xs text-night-faint" aria-label="Legal">
        <a href="/terms" class="transition-colors hover:text-night-text">Terms</a>
        <span class="text-night-hairline-strong">&middot;</span>
        <a href="/privacy" class="transition-colors hover:text-night-text">Privacy</a>
        <span class="text-night-hairline-strong">&middot;</span>
        <a href="/docs/deployment/licensing/" class="transition-colors hover:text-night-text">Licensing</a>
      </nav>
    </div>
  </div>
</footer>
