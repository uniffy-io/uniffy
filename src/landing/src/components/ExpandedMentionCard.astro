---
import type { CardData } from "@/components/cardTypes";

interface Props {
  card: CardData;
  className?: string;
  variant?: "light" | "dark";
}

const { card, className = "", variant = "light" } = Astro.props;
const variantClass = variant === "dark" ? "card-dark" : "";

const presenceStyles: Record<string, { dot: string; label: string; text: string }> = {
  online: { dot: "bg-green-500", label: "Online", text: "text-green-600" },
  away: { dot: "bg-amber-500", label: "Away", text: "text-amber-600" },
  dnd: { dot: "bg-red-500", label: "Do Not Disturb", text: "text-red-600" },
  offline: { dot: "bg-gray-400", label: "Offline", text: "text-ink-muted" },
};
---

<div
  data-card-type={card.type}
  class={`expanded-mention-card ${variantClass} group relative block w-80 overflow-hidden rounded-xl border border-hairline bg-paper shadow-[0_1px_2px_rgba(10,10,10,0.04),0_4px_12px_-4px_rgba(10,10,10,0.06)] transition-all duration-300 ease-out hover:-translate-y-1 hover:border-ink/15 hover:shadow-[0_2px_4px_rgba(10,10,10,0.04),0_24px_48px_-16px_rgba(10,10,10,0.18),0_8px_24px_-12px_rgba(10,10,10,0.1)] ${className}`}
>
  {card.type === "note" && (
    <>
      <div class="pointer-events-none absolute inset-x-0 top-0 h-12 bg-gradient-to-b from-violet-500/10 via-violet-500/5 to-transparent"></div>
      <div class="relative px-5 pt-3 pb-1 pr-10">
        <div class="flex items-center gap-2.5">
          <span data-tether-anchor class="grid h-7 w-7 shrink-0 place-items-center rounded-md border border-accent/55 bg-accent/10 text-accent">
            <svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor"><path d="M227.32 73.37 182.63 28.69a16 16 0 0 0-22.63 0L36.69 152a15.86 15.86 0 0 0-4.69 11.31V208a16 16 0 0 0 16 16h44.69a15.86 15.86 0 0 0 11.31-4.69L227.32 96a16 16 0 0 0 0-22.63ZM92.69 208H48v-44.69l88-88L180.69 120ZM192 108.69 147.32 64l24-24L216 84.69Z"/></svg>
          </span>
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-semibold text-ink">{card.title}</p>
            <div class="flex items-center gap-1.5">
              <span class="text-[10px] font-medium text-violet-600">Note</span>
              {card.isBeingEdited && (
                <>
                  <span class="text-ink-faint">·</span>
                  <span class="inline-flex items-center gap-1 text-[10px] text-ink-muted">
                    <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-violet-500"></span>
                    {card.editorName} editing
                  </span>
                </>
              )}
            </div>
          </div>
        </div>
      </div>
      {card.description && (
        <div class="px-5 pb-2 pl-[3.375rem]">
          <p class="line-clamp-3 text-xs leading-relaxed text-ink-muted" data-live="note-description">{card.description}</p>
        </div>
      )}
      {card.tags && card.tags.length > 0 && (
        <div class="flex flex-wrap items-center gap-1.5 px-5 pb-2 pl-[3.375rem]">
          <svg width="10" height="10" viewBox="0 0 256 256" fill="currentColor" class="shrink-0 text-ink-faint"><path d="M243.31 136 144 36.69A15.86 15.86 0 0 0 132.69 32H40a8 8 0 0 0-8 8v92.69A15.86 15.86 0 0 0 36.69 144L136 243.31a16 16 0 0 0 22.63 0l84.68-84.68a16 16 0 0 0 0-22.63ZM84 96a12 12 0 1 1 12-12 12 12 0 0 1-12 12Z"/></svg>
          {card.tags.slice(0, 4).map((tag: string) => (
            <span class="inline-flex items-center rounded-full bg-paper-soft px-1.5 py-px text-[10px] font-medium text-ink-muted">{tag}</span>
          ))}
        </div>
      )}
      <div class="flex items-center justify-between border-t border-hairline bg-paper-soft px-5 py-1.5">
        <span class="inline-flex items-center gap-1.5 text-xs text-ink-muted">
          <svg width="12" height="12" viewBox="0 0 256 256" fill="currentColor"><path d="M128 24a104 104 0 1 0 104 104A104.11 104.11 0 0 0 128 24Zm56 112h-56a8 8 0 0 1-8-8V72a8 8 0 0 1 16 0v48h48a8 8 0 0 1 0 16Z"/></svg>
          <span data-live="updated-at">{card.updatedAt}</span>
          {card.updatedBy && (
            <>
              <span class="text-ink-faint">·</span>
              <span class="max-w-[80px] truncate">{card.updatedBy}</span>
            </>
          )}
        </span>
        <span class="inline-flex items-center gap-1 text-xs text-ink-muted">
          <svg width="11" height="11" viewBox="0 0 256 256" fill="currentColor"><path d="M200 64v104a8 8 0 0 1-16 0V83.31l-114.34 114.35a8 8 0 0 1-11.32-11.32L172.69 72H88a8 8 0 0 1 0-16h104a8 8 0 0 1 8 8Z"/></svg>
          <span>Open</span>
        </span>
      </div>
    </>
  )}

  {card.type === "file" && (
    <>
      {card.thumbnailUrl ? (
        <div class="relative h-32 w-full overflow-hidden bg-paper-soft">
          <img src={card.thumbnailUrl} alt="" class="h-full w-full object-cover" />
        </div>
      ) : (
        <div class="pointer-events-none absolute inset-x-0 top-0 h-16 bg-gradient-to-b from-blue-500/10 via-blue-500/5 to-transparent"></div>
      )}
      <div class="relative px-5 pt-3 pb-2 pr-10">
        <div class="flex items-start gap-3">
          <span data-tether-anchor class="grid h-8 w-8 shrink-0 place-items-center rounded-lg border border-accent/55 bg-accent/10 text-accent">
            <svg width="18" height="18" viewBox="0 0 256 256" fill="currentColor"><path d="M213.66 82.34 173.66 42.34A8 8 0 0 0 168 40H72a16 16 0 0 0-16 16v144a16 16 0 0 0 16 16h128a16 16 0 0 0 16-16V88a8 8 0 0 0-2.34-5.66ZM168 56l32 32h-32ZM72 56h80v40a8 8 0 0 0 8 8h40v96H72Zm88 84a8 8 0 0 1-8 8h-48a8 8 0 0 1 0-16h48a8 8 0 0 1 8 8Zm0 32a8 8 0 0 1-8 8h-48a8 8 0 0 1 0-16h48a8 8 0 0 1 8 8Z"/></svg>
          </span>
          <div class="min-w-0 flex-1 pt-0.5">
            <p class="truncate text-sm font-semibold text-ink">{card.title}</p>
            <div class="mt-0.5 flex items-center gap-1.5">
              <span class="text-xs font-medium text-blue-600">{card.mime.split("/")[1]?.toUpperCase()}</span>
              <span class="text-ink-faint">·</span>
              <span class="text-xs text-ink-muted">{card.size}</span>
            </div>
          </div>
        </div>
      </div>
      {card.description && (
        <div class="px-5 pb-2 pl-[3.875rem]">
          <p class="line-clamp-2 text-xs leading-relaxed text-ink-muted">{card.description}</p>
        </div>
      )}
      {card.tags && card.tags.length > 0 && (
        <div class="flex flex-wrap items-center gap-1.5 px-5 pb-2 pl-[3.875rem]">
          <svg width="10" height="10" viewBox="0 0 256 256" fill="currentColor" class="shrink-0 text-ink-faint"><path d="M243.31 136 144 36.69A15.86 15.86 0 0 0 132.69 32H40a8 8 0 0 0-8 8v92.69A15.86 15.86 0 0 0 36.69 144L136 243.31a16 16 0 0 0 22.63 0l84.68-84.68a16 16 0 0 0 0-22.63ZM84 96a12 12 0 1 1 12-12 12 12 0 0 1-12 12Z"/></svg>
          {card.tags.slice(0, 4).map((tag: string) => (
            <span class="inline-flex items-center rounded-full bg-paper-soft px-1.5 py-px text-[10px] font-medium text-ink-muted">{tag}</span>
          ))}
        </div>
      )}
      <div class="flex items-center justify-between border-t border-hairline bg-paper-soft px-5 py-2">
        <span class="inline-flex items-center gap-1.5 text-xs text-ink-muted">
          <svg width="12" height="12" viewBox="0 0 256 256" fill="currentColor"><path d="M128 24a104 104 0 1 0 104 104A104.11 104.11 0 0 0 128 24Zm56 112h-56a8 8 0 0 1-8-8V72a8 8 0 0 1 16 0v48h48a8 8 0 0 1 0 16Z"/></svg>
          <span>{card.updatedAt}</span>
        </span>
        <span class="inline-flex items-center gap-1 text-xs text-ink-muted">
          <svg width="11" height="11" viewBox="0 0 256 256" fill="currentColor"><path d="M200 64v104a8 8 0 0 1-16 0V83.31l-114.34 114.35a8 8 0 0 1-11.32-11.32L172.69 72H88a8 8 0 0 1 0-16h104a8 8 0 0 1 8 8Z"/></svg>
          <span>Open</span>
        </span>
      </div>
    </>
  )}

  {card.type === "event" && (
    <>
      <div class="pointer-events-none absolute inset-x-0 top-0 h-16 bg-gradient-to-b from-rose-500/10 via-rose-500/5 to-transparent"></div>
      <div class="relative px-5 pt-3.5 pb-1.5 pr-10">
        <div class="flex items-start gap-3">
          <span data-tether-anchor class="grid h-10 w-10 shrink-0 place-items-center rounded-lg border border-accent/55 bg-accent/10 text-accent">
            <svg width="18" height="18" viewBox="0 0 256 256" fill="currentColor"><path d="M208 32h-24v-8a8 8 0 0 0-16 0v8H88v-8a8 8 0 0 0-16 0v8H48a16 16 0 0 0-16 16v160a16 16 0 0 0 16 16h160a16 16 0 0 0 16-16V48a16 16 0 0 0-16-16Zm0 16v32H48V48Zm0 160H48V96h160v112Zm-72-72a12 12 0 1 1-12-12 12 12 0 0 1 12 12Zm44 0a12 12 0 1 1-12-12 12 12 0 0 1 12 12Zm-88 36a12 12 0 1 1-12-12 12 12 0 0 1 12 12Zm44 0a12 12 0 1 1-12-12 12 12 0 0 1 12 12Zm44 0a12 12 0 1 1-12-12 12 12 0 0 1 12 12Z"/></svg>
          </span>
          <div class="min-w-0 flex-1 pt-0.5">
            <p class="truncate text-sm font-semibold text-ink">{card.title}</p>
            <div class="mt-0.5 flex items-center gap-1.5">
              <span class="text-xs font-medium text-rose-600">Event</span>
              {card.temporal && (
                <>
                  <span class="text-ink-faint">·</span>
                  <span class="inline-flex items-center gap-1 rounded-full bg-rose-50 px-1.5 py-px text-[10px] font-medium text-rose-700">
                    <span class="h-1 w-1 rounded-full bg-rose-500"></span>
                    <span data-live="event-temporal">{card.temporal}</span>
                  </span>
                </>
              )}
            </div>
          </div>
        </div>
      </div>
      <div class="px-5 pb-2 pl-5">
        <div class="flex items-center gap-2 text-xs text-ink-muted">
          <svg width="13" height="13" viewBox="0 0 256 256" fill="currentColor" class="shrink-0 text-rose-500"><path d="M128 24a104 104 0 1 0 104 104A104.11 104.11 0 0 0 128 24Zm56 112h-56a8 8 0 0 1-8-8V72a8 8 0 0 1 16 0v48h48a8 8 0 0 1 0 16Z"/></svg>
          <span>{card.timeRange}</span>
        </div>
      </div>
      {card.location && (
        <div class="px-5 pb-2 pl-5">
          <div class="flex items-center gap-2 text-xs text-ink-muted">
            <svg width="13" height="13" viewBox="0 0 256 256" fill="currentColor" class="shrink-0 text-rose-500"><path d="M128 16a88.1 88.1 0 0 0-88 88c0 75.3 80 132.17 83.41 134.55a8 8 0 0 0 9.18 0C136 236.17 216 179.3 216 104a88.1 88.1 0 0 0-88-88Zm0 56a32 32 0 1 1-32 32 32 32 0 0 1 32-32Z"/></svg>
            <span class="truncate">{card.location}</span>
          </div>
        </div>
      )}
      {card.meetingUrl && (
        <div class="px-5 pb-2 pl-5">
          <span class="inline-flex items-center gap-1.5 text-xs font-medium text-ink">
            <svg width="13" height="13" viewBox="0 0 256 256" fill="currentColor"><path d="M251.77 73a8 8 0 0 0-8.21.39L208 97.05V72a16 16 0 0 0-16-16H32a16 16 0 0 0-16 16v112a16 16 0 0 0 16 16h160a16 16 0 0 0 16-16v-25.05l35.56 23.71A8 8 0 0 0 256 176V80a8 8 0 0 0-4.23-7Z"/></svg>
            <span>Join meeting</span>
          </span>
        </div>
      )}
      {card.description && (
        <div class="px-5 pb-2.5 pl-5">
          <p class="line-clamp-2 text-xs leading-relaxed text-ink-muted">{card.description}</p>
        </div>
      )}
      <div class="flex items-center justify-between border-t border-hairline bg-paper-soft px-5 py-2">
        <span class="inline-flex items-center gap-1.5 text-xs text-ink-muted">
          <svg width="12" height="12" viewBox="0 0 256 256" fill="currentColor"><path d="M128 24a104 104 0 1 0 104 104A104.11 104.11 0 0 0 128 24Zm56 112h-56a8 8 0 0 1-8-8V72a8 8 0 0 1 16 0v48h48a8 8 0 0 1 0 16Z"/></svg>
          <span>{card.updatedAt}</span>
        </span>
        <span class="inline-flex items-center gap-1 text-xs text-ink-muted">
          <svg width="11" height="11" viewBox="0 0 256 256" fill="currentColor"><path d="M200 64v104a8 8 0 0 1-16 0V83.31l-114.34 114.35a8 8 0 0 1-11.32-11.32L172.69 72H88a8 8 0 0 1 0-16h104a8 8 0 0 1 8 8Z"/></svg>
          <span>Open</span>
        </span>
      </div>
    </>
  )}

  {card.type === "user" && (
    <>
      <div class="pointer-events-none absolute inset-x-0 top-0 h-16 bg-gradient-to-b from-emerald-500/10 via-emerald-500/5 to-transparent"></div>
      <div class="relative px-5 pt-3.5 pb-2 pr-10">
        <div class="flex items-start gap-3">
          <div class="relative shrink-0">
            <span data-tether-anchor class="grid h-8 w-8 place-items-center rounded-md border border-accent/55 bg-accent/10 text-[11px] font-semibold text-accent">
              {card.title.split(" ").map((w: string) => w[0]).join("").slice(0, 2).toUpperCase()}
            </span>
            <span class={`absolute -bottom-0.5 -right-0.5 h-2 w-2 rounded-full ${presenceStyles[card.presence].dot} ring-1 ring-paper`}></span>
          </div>
          <div class="min-w-0 flex-1 pt-0.5">
            <p class="truncate text-sm font-semibold text-ink">{card.title}</p>
            <p class="truncate text-xs text-ink-muted">{card.email}</p>
            <div class="mt-1 flex flex-wrap items-center gap-1.5">
              <span class={`text-xs font-medium ${presenceStyles[card.presence].text}`}>
                {presenceStyles[card.presence].label}
              </span>
              {card.customStatus && (
                <>
                  <span class="text-ink-faint">·</span>
                  <span class="inline-flex items-center gap-1 truncate text-xs text-ink-muted">
                    {card.customStatus.emoji && <span>{card.customStatus.emoji}</span>}
                    <span class="truncate">{card.customStatus.text}</span>
                  </span>
                </>
              )}
            </div>
          </div>
        </div>
      </div>
      <div class="flex items-center gap-2 border-t border-hairline bg-paper-soft px-5 py-2.5">
        <span class="inline-flex items-center gap-1 text-xs text-ink-muted">
          <svg width="12" height="12" viewBox="0 0 256 256" fill="currentColor"><path d="M200 64v104a8 8 0 0 1-16 0V83.31l-114.34 114.35a8 8 0 0 1-11.32-11.32L172.69 72H88a8 8 0 0 1 0-16h104a8 8 0 0 1 8 8Z"/></svg>
          <span>Profile</span>
        </span>
      </div>
    </>
  )}

  {card.type === "project" && (
    <>
      <div class="pointer-events-none absolute inset-x-0 top-0 h-12 bg-gradient-to-b from-orange-500/10 via-orange-500/5 to-transparent"></div>
      <div class="relative px-5 pt-3 pb-2 pr-10">
        <div class="flex items-center gap-2.5">
          <span data-tether-anchor class="grid h-8 w-8 shrink-0 place-items-center rounded-md border border-accent/55 bg-accent/10 text-accent">
            <svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor"><path d="M216 40H40a16 16 0 0 0-16 16v144a16 16 0 0 0 16 16h176a16 16 0 0 0 16-16V56a16 16 0 0 0-16-16ZM96 200H40v-72h56Zm0-88H40V56h56Zm64 88h-48v-128h48Zm56 0h-40V56h40Z"/></svg>
          </span>
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-semibold text-ink">{card.title}</p>
            <div class="flex items-center gap-1.5">
              <span class="font-mono text-[10px] text-ink-muted">{card.slug}</span>
              <span class="text-ink-faint">·</span>
              <span class="text-[10px] font-medium text-orange-600">Project</span>
            </div>
          </div>
        </div>
      </div>
      {card.description && (
        <div class="px-5 pb-2 pl-[3.375rem]">
          <p class="line-clamp-2 text-xs leading-relaxed text-ink-muted">{card.description}</p>
        </div>
      )}
      <div class="px-5 pb-2 pl-[3.375rem]" data-project-root data-completed={card.completedTasks} data-total={card.totalTasks}>
        <div class="mb-1.5 flex items-baseline justify-between text-xs">
          <span class="text-ink-muted"><span data-live="project-completed">{card.completedTasks}</span> of {card.totalTasks} tasks</span>
          <span class="font-medium text-ink" data-live="project-percent">{Math.round((card.completedTasks / card.totalTasks) * 100)}%</span>
        </div>
        <div class="h-1.5 overflow-hidden rounded-full bg-paper-soft">
          <div class="h-full bg-gradient-to-r from-orange-500 to-orange-600 transition-[width] duration-700 ease-out" data-live="project-bar" style={`width: ${(card.completedTasks / card.totalTasks) * 100}%`}></div>
        </div>
      </div>
      {card.tags && card.tags.length > 0 && (
        <div class="flex flex-wrap items-center gap-1.5 px-5 pb-2 pl-[3.375rem]">
          <svg width="10" height="10" viewBox="0 0 256 256" fill="currentColor" class="shrink-0 text-ink-faint"><path d="M243.31 136 144 36.69A15.86 15.86 0 0 0 132.69 32H40a8 8 0 0 0-8 8v92.69A15.86 15.86 0 0 0 36.69 144L136 243.31a16 16 0 0 0 22.63 0l84.68-84.68a16 16 0 0 0 0-22.63ZM84 96a12 12 0 1 1 12-12 12 12 0 0 1-12 12Z"/></svg>
          {card.tags.slice(0, 4).map((tag: string) => (
            <span class="inline-flex items-center rounded-full bg-paper-soft px-1.5 py-px text-[10px] font-medium text-ink-muted">{tag}</span>
          ))}
        </div>
      )}
      <div class="flex items-center justify-between border-t border-hairline bg-paper-soft px-5 py-2">
        <span class="inline-flex items-center gap-1.5 text-xs text-ink-muted">
          <svg width="12" height="12" viewBox="0 0 256 256" fill="currentColor"><path d="M128 24a104 104 0 1 0 104 104A104.11 104.11 0 0 0 128 24Zm56 112h-56a8 8 0 0 1-8-8V72a8 8 0 0 1 16 0v48h48a8 8 0 0 1 0 16Z"/></svg>
          <span>{card.updatedAt}</span>
        </span>
        <span class="inline-flex items-center gap-1 text-xs text-ink-muted">
          <svg width="11" height="11" viewBox="0 0 256 256" fill="currentColor"><path d="M200 64v104a8 8 0 0 1-16 0V83.31l-114.34 114.35a8 8 0 0 1-11.32-11.32L172.69 72H88a8 8 0 0 1 0-16h104a8 8 0 0 1 8 8Z"/></svg>
          <span>Open</span>
        </span>
      </div>
    </>
  )}

  {card.type === "chat" && (
    <>
      <div class="pointer-events-none absolute inset-x-0 top-0 h-12 bg-gradient-to-b from-violet-500/10 via-violet-500/5 to-transparent"></div>
      <div class="relative px-5 pt-3 pb-2 pr-10">
        <div class="flex items-center gap-2.5">
          <span data-tether-anchor class="grid h-8 w-8 shrink-0 place-items-center rounded-md border border-accent/55 bg-accent/10 text-accent">
            <svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor"><path d="M216 48H40a16 16 0 0 0-16 16v160a15.85 15.85 0 0 0 9.24 14.5 16.13 16.13 0 0 0 6.78 1.5 15.89 15.89 0 0 0 9.93-3.49l43.51-34.51H216a16 16 0 0 0 16-16V64a16 16 0 0 0-16-16Z"/></svg>
          </span>
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-semibold text-ink">{card.title}</p>
            <div class="flex items-center gap-1.5">
              <span class="text-[10px] font-medium text-violet-600">Channel</span>
              {card.memberCount && (
                <>
                  <span class="text-ink-faint">·</span>
                  <span class="text-[10px] text-ink-muted">{card.memberCount} members</span>
                </>
              )}
            </div>
          </div>
        </div>
      </div>
      <div class="px-5 pb-2 pl-[3.375rem]">
        <p class="line-clamp-2 text-xs leading-relaxed text-ink-muted">
          <span class="font-medium text-ink-soft" data-live="chat-sender">{card.lastSender}</span>: <span data-live="chat-message">{card.lastMessage}</span>
        </p>
      </div>
      {card.tags && card.tags.length > 0 && (
        <div class="flex flex-wrap items-center gap-1.5 px-5 pb-2 pl-[3.375rem]">
          <svg width="10" height="10" viewBox="0 0 256 256" fill="currentColor" class="shrink-0 text-ink-faint"><path d="M243.31 136 144 36.69A15.86 15.86 0 0 0 132.69 32H40a8 8 0 0 0-8 8v92.69A15.86 15.86 0 0 0 36.69 144L136 243.31a16 16 0 0 0 22.63 0l84.68-84.68a16 16 0 0 0 0-22.63ZM84 96a12 12 0 1 1 12-12 12 12 0 0 1-12 12Z"/></svg>
          {card.tags.slice(0, 4).map((tag: string) => (
            <span class="inline-flex items-center rounded-full bg-paper-soft px-1.5 py-px text-[10px] font-medium text-ink-muted">{tag}</span>
          ))}
        </div>
      )}
      <div class="flex items-center justify-between border-t border-hairline bg-paper-soft px-5 py-1.5">
        <span class="inline-flex items-center gap-1.5 text-xs text-ink-muted">
          <svg width="12" height="12" viewBox="0 0 256 256" fill="currentColor"><path d="M128 24a104 104 0 1 0 104 104A104.11 104.11 0 0 0 128 24Zm56 112h-56a8 8 0 0 1-8-8V72a8 8 0 0 1 16 0v48h48a8 8 0 0 1 0 16Z"/></svg>
          <span>{card.updatedAt}</span>
        </span>
        <span class="inline-flex items-center gap-1 text-xs text-ink-muted">
          <svg width="11" height="11" viewBox="0 0 256 256" fill="currentColor"><path d="M200 64v104a8 8 0 0 1-16 0V83.31l-114.34 114.35a8 8 0 0 1-11.32-11.32L172.69 72H88a8 8 0 0 1 0-16h104a8 8 0 0 1 8 8Z"/></svg>
