---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  image?: string;
  ogType?: "website" | "article";
  article?: { publishedTime: string; modifiedTime?: string; tags?: string[] };
  jsonLd?: Record<string, unknown>;
}

const {
  title = "Uniffy | Self hosted workspace for teams",
  description = "Uniffy brings notes, chat, calls, files, projects, calendars, and AI agents into one private workspace. Open source. Free to self host with no user limit.",
  noindex = false,
  image = "/og.png",
  ogType = "website",
  article,
  jsonLd,
} = Astro.props;
const siteUrl = Astro.site!;
const canonicalUrl = new URL(Astro.url.pathname.replace(/\/?$/, "/"), siteUrl);
const imageUrl = new URL(image, siteUrl);
const isHomePage = Astro.url.pathname === "/";
const isNotFoundPage = Astro.url.pathname === "/404" || Astro.url.pathname === "/404/";
const identity = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": new URL("#website", siteUrl).href,
      name: "Uniffy",
      url: siteUrl.href,
      publisher: { "@id": new URL("#organization", siteUrl).href },
    },
    {
      "@type": "Organization",
      "@id": new URL("#organization", siteUrl).href,
      name: "Uniffy",
      url: siteUrl.href,
      logo: new URL("/web-app-manifest-512x512.png", siteUrl).href,
      sameAs: ["https://github.com/uniffy-io"],
    },
  ],
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!isNotFoundPage && <link rel="canonical" href={canonicalUrl.href} />}
    <meta property="og:site_name" content="Uniffy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={imageUrl.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imageUrl.href} />
    <link rel="alternate" type="application/rss+xml" title="Uniffy Blog" href="/blog/rss.xml" />
    {article && <meta property="article:published_time" content={article.publishedTime} />}
    {article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
    {article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    {isHomePage && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(identity).replace(/</g, "\\u003c")} />
    )}
    {jsonLd && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />
    )}
  </head>
  <body class="bg-night text-night-text min-h-screen flex flex-col">
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
