---
import LegalLayout from "@/layouts/LegalLayout.astro";

const COMPANY = "Uniffy, Inc.";
const CONTACT = "support@uniffy.io";
const GOVERNING_LAW = "Bulgaria";
const FORUM = "the courts of Sofia, Bulgaria";
const EFFECTIVE = "19 July 2026";
---

<LegalLayout
  title="Terms of Service"
  description="The terms that govern your use of Uniffy, including the Uniffy mobile app and the cloud.uniffy.io hosted service."
  effectiveDate={EFFECTIVE}
  intro="These terms are a contract between you and Uniffy. They cover the Uniffy mobile app and our hosted service at cloud.uniffy.io. Please read them before you create an account or use the app."
>
  <h2 id="acceptance" data-toc-label="1. Acceptance"><span class="legal-prose__num">01</span>Acceptance of these terms</h2>
  <p>
    These Terms of Service ("Terms") govern your access to and use of the {" "}
    <strong>Uniffy</strong> mobile application, the hosted service at <code>cloud.uniffy.io</code>,
    and related websites and services that link to these Terms (together, the "Service"). The Service is
    provided by {COMPANY} ("Uniffy", "we", "us", or "our").
  </p>
  <p>
    By creating an account, installing the app, or otherwise using the Service, you agree to these Terms and
    to our <a href="/privacy">Privacy Policy</a>. If you do not agree, do not use the Service. If you use the
    Service on behalf of an organization, you confirm that you are authorized to accept these Terms for that
