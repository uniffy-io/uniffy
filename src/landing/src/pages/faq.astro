---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Faq from "@/components/sections/Faq.astro";
---

<BaseLayout
  title="Uniffy | FAQ"
  description="The questions every Uniffy evaluation lands on. Licensing, pricing, the cloud, AI, and your data, answered straight."
>
  <Faq />
  <div class="bg-night-gradient px-5 pb-20 text-center sm:px-6 md:px-10">
    <p class="font-mono text-xs text-night-faint">
      Question not here? <a href="/contact" class="text-accent-strong hover:underline">Talk to a human</a>.
    </p>
  </div>
</BaseLayout>
