{% extends "base.html.j2" %}
{% block title %}Restore window for {{ org_name }} closes in 24 hours{% endblock %}
{% block content %}
<p style="margin:0 0 16px 0;font-size:16px;font-weight:600;">The restore window for {{ org_name }} closes on {{ purge_at }}.</p>
<p style="margin:0 0 16px 0;">Your workspace was marked for deletion and has been kept restorable since then. Once {{ purge_at }} passes, that guarantee ends: the workspace and all its content (notes, files, chat, calendar, projects) can be removed permanently at any time, and restoring it may no longer be possible.</p>
{% if reason %}
<p style="margin:0 0 16px 0;"><strong>Reason recorded at the time of deletion:</strong> {{ reason }}</p>
{% endif %}
<p style="margin:0 0 16px 0;">If this is a mistake, contact your platform admin or support now, while the workspace can still be restored.</p>
<p style="margin:0;font-size:13px;color:#6b7280;">This notice is automatic; the original action is recorded in your workspace audit log.</p>
{% endblock %}
