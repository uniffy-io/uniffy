{% extends "base.html.j2" %}
{% block title %}Two-factor authentication was reset{% endblock %}
{% block content %}
<p style="margin:0 0 16px 0;font-size:16px;font-weight:600;">Two-factor authentication was reset</p>
<p style="margin:0 0 16px 0;">Hi{% if user_name %} {{ user_name }}{% endif %}, an administrator of <strong>{{ org_name }}</strong>{% if actor_name %} ({{ actor_name }}){% endif %} reset the two-factor authentication on your account. Every existing session has been signed out and your recovery codes have been invalidated.</p>
<p style="margin:0 0 16px 0;">The next time you sign in you will be guided through enrolling a new authenticator app and shown a fresh set of recovery codes.</p>
{% if reason %}
<p style="margin:0 0 16px 0;font-size:13px;color:#6b7280;">Reason given by the administrator: {{ reason }}</p>
{% endif %}
<p style="margin:0;font-size:13px;color:#6b7280;">If you did not expect this change, contact your organization administrator immediately.</p>
{% endblock %}
