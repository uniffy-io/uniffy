{% extends "base.html.j2" %}
{% block title %}You are invited to {{ org_name }}{% endblock %}
{% block content %}
<p style="margin:0 0 16px 0;font-size:16px;font-weight:600;">You have been invited to join {{ org_name }}.</p>
<p style="margin:0 0 16px 0;">{{ inviter_name }} has invited you to collaborate in <strong>{{ org_name }}</strong> on Uniffy as a <strong>{{ role }}</strong>.</p>
<p style="margin:0 0 24px 0;">
  <a href="{{ accept_url }}" style="display:inline-block;background-color:#111111;color:#ffffff;text-decoration:none;font-weight:600;padding:12px 20px;border-radius:6px;">Accept invitation</a>
</p>
<p style="margin:0 0 12px 0;font-size:13px;color:#6b7280;">Or paste this link in your browser:</p>
<p style="margin:0 0 16px 0;font-size:13px;color:#374151;word-break:break-all;">{{ accept_url }}</p>
<p style="margin:0;font-size:13px;color:#6b7280;">This invitation expires in {{ expires_in_days }} days. If you did not expect this, you can ignore the email.</p>
{% endblock %}
