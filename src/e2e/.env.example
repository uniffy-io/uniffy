# Where the app is reachable (browser-side)
# Local dev (default): vite at 5173 proxies /api to backend at 8000
# CI: ui container at http://ui:4173, with /api proxied to http://backend:8000
E2E_BASE_URL=http://localhost:5173

# Where the backend ConnectRPC API is reachable (node-side, yes proxy)
# auth.setup.ts and fixtures/api.ts hit this directly to acquire tokens
# and to seed/clean test data without going through the UI
E2E_API_URL=http://localhost:8000/api

# When set to "1", the backend uses the deterministic LLM stub provider
# for agent runs (no real Anthropic/OpenAI/Google calls). Required for
# the agents specs in CI; optional locally. Mirrors the backend env var
# of the same name.
E2E_LLM_STUB=0

# Bearer token used by the per-org `/api/_e2e/llm_stub` debug route to
# script agent replies. Only honoured when LLM_STUB=1 on the backend.
# Generate with `openssl rand -hex 32`.
E2E_ADMIN_TOKEN=

# Seeded credentials. The backend's `seed_dev.py` creates these users in
# the default org with INITIAL_ADMIN_PASSWORD. auth.setup.ts logs each
# role in once and persists storageState/{role}.json.
E2E_ADMIN_EMAIL=admin@uniffy.io
E2E_ADMIN_PASSWORD=admin
E2E_ALICE_EMAIL=alice@uniffy.io
E2E_BOB_EMAIL=bob@uniffy.io
E2E_DEFAULT_PASSWORD=admin

# Org slug used by login. Empty -> backend picks the user's first org.
E2E_ORG_SLUG=
