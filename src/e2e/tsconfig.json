{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "@playwright/test"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@e2e/*": ["./*"],
      "@uniffy/proto/*": ["../proto/gen/typescript/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "reports", "storageState"]
}
