  "fields": {
    "update_id": "Minted by the client for one durable write. The server echoes it in messages 7 and 11.",
    "generation": "Minted by the server in PostgreSQL. Changes only on intentional replacement. Empty for historical snapshots.",
    "epoch": "Minted by the server in PostgreSQL when the edit buffer is initialized or reset. The generation stays the same. Opaque and compared only for equality.",
    "accepted_sequence": "Issued by the server for one accepted update. Strictly increasing within one generation and epoch, starting at 1.",
    "covered_sequence": "Highest accepted sequence of the generation and epoch that PostgreSQL has committed. 0 covers nothing.",
    "head_sequence": "Highest accepted sequence issued in the generation and epoch. 0 before the first update.",
    "checkpoint_sequence": "The covered sequence reported when a client attaches. Never above head_sequence.",
    "checkpoint_revision": "PostgreSQL snapshot revision that holds the checkpoint.",
    "scope": "Document denial scope. 0 refuses writes and keeps the document readable; 1 removes view access.",
    "reason": "Why the server refused. Clients match the reasons in denials exactly."
  },
  "coverage": {
    "local": "The device holds the edit and the server has not confirmed it. Retry and local recovery keep it.",
    "accepted": "The server appended the edit to its buffer. Routine retransmission stops. Local recovery keeps it.",
    "checkpointed": "A PostgreSQL commit includes the edit. Its retry bytes and local dirty marker can retire."
  },
  "rules": [
    "Session state sets the current generation and epoch.",
    "A receipt with the current generation and epoch moves its update from local to accepted.",
    "Progress or session state with the current generation and epoch checkpoints every accepted update whose accepted_sequence is at or below its covered_sequence or checkpoint_sequence.",
    "Progress that arrives before a receipt stays as the epoch watermark and checkpoints the update when its receipt arrives.",
    "Session state with a new epoch returns every accepted update that is not checkpointed to local. Those updates replay and get receipts in the new epoch.",
    "A frame for another generation or epoch never changes coverage.",
    "Message 7 still means committed. The server sends it for synchronous writes such as fragment seed proposals and for an update whose bytes the checkpoint already holds, never for a buffer append."
  ],
