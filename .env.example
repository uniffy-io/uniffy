# Host to bind the server to
HOST=0.0.0.0
# Port to listen on
PORT=8000
# Number of server workers (use 1 for development, 2-4 for production)
WORKERS=1
# Log level: debug, info, warning, error, critical
LOG_LEVEL=debug
# Environment name: development, staging, production
ENVIRONMENT=development
# Comma-separated list of allowed origins, or * for all (development only)
# Example: https://app.example.com,https://admin.example.com
CORS_ORIGINS=*


POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=uniffy
POSTGRES_PASSWORD=uniffy
POSTGRES_DB=uniffy
# Echo SQL queries to console (useful for debugging)
SQL_ECHO=false
# Database connection pool size
DB_POOL_SIZE=30
# Maximum overflow connections beyond pool size
DB_MAX_OVERFLOW=70
# Recycle connections after N seconds (prevents stale connections)
DB_POOL_RECYCLE=1800
# Seconds to wait for a connection from the pool before timing out
DB_POOL_TIMEOUT=10
# Maximum time in milliseconds for a single SQL statement
DB_STATEMENT_TIMEOUT_MS=30000
# Maximum time in seconds for asyncpg command execution
DB_COMMAND_TIMEOUT=30


# Secret key for JWT tokens - CHANGE THIS IN PRODUCTION
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32
# Access token expiration time in minutes (default: 480 = 8 hours)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Master Key Encryption Key (KEK) for at-rest encryption of per-org DEKs and
# app-wide secrets (VAPID private key). Wraps every per-org Data Encryption
# Key stored in org_encryption_keys; losing this key permanently locks every
# encrypted column in the deployment.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MUST be set before the application starts (no fallback, no derivation).
APP_MASTER_KEY=


# Initial admin email address (used for VAPID contact and admin user)
INITIAL_ADMIN_EMAIL=admin@uniffy.io
# Initial admin password for seeding (development only)
INITIAL_ADMIN_PASSWORD=admin
# Default organization name
DEFAULT_ORG_NAME=Default
# Default organization slug (auto-generated from name if not set)
DEFAULT_ORG_SLUG=


# Valkey server hostname
VALKEY_HOST=localhost
# Valkey server port (mapped to 6380 in docker-compose)
VALKEY_PORT=6380
# Valkey password
VALKEY_PASSWORD=uniffy-valkey-dev
# Valkey database number (0-15)
VALKEY_DATABASE=0
# Connection profiles are now baked into ValkeyConfig by tier:
#   ARQ queue   - 10s timeout, 5 retries, 1s delay (job dequeue tolerates retries)
#   Pub/Sub     - 5s timeout, retry on transient, 30s health check
#   Ops client  - 200ms connect, 100ms read, 0 retries; cache calls are wrapped
#                 in a 150ms deadline guard so a slow Valkey turns into a miss
#                 instead of stalling the user request.
# Per-tier values are not env-tunable - one dial per tier in code.


# Meilisearch server URL
MEILISEARCH_URL=http://localhost:7700
# Master API key for authentication
MEILISEARCH_MASTER_KEY=uniffy-dev-master-key
# HTTP request timeout in seconds
MEILISEARCH_TIMEOUT=30


# Worker fleet split: two ARQ workers per pod (run as separate processes /
# Deployments). The core fleet handles thumbnails / extraction /
# notifications / reminders / storage / chat-mute (tight SLA, local I/O).
# The egress fleet handles agent runtime / compaction / cron / future
# external-API integrations (slow, retry-heavy, I/O bound).
#   arq uniffy.workers.settings.CoreWorkerSettings
#   arq uniffy.workers.settings.EgressWorkerSettings
CORE_WORKER_MAX_JOBS=10
CORE_WORKER_POLL_DELAY=0.5
EGRESS_WORKER_MAX_JOBS=50
EGRESS_WORKER_POLL_DELAY=0.05
# Job timeout in seconds for the core fleet (default: 5 minutes).
WORKER_JOB_TIMEOUT=300
# Job timeout in seconds for the egress fleet. Agent runtime jobs can
# legitimately run up to MAX_TOOL_ITERATIONS * 60s when slow tools fan
# out, so the egress ceiling is bumped above the core default.
EGRESS_WORKER_JOB_TIMEOUT=900
# How long to keep job results in seconds (default: 1 hour)
WORKER_KEEP_RESULT=3600
# Maximum retry attempts for failed jobs
WORKER_MAX_TRIES=3
# Seconds between health checks
WORKER_HEALTH_CHECK_INTERVAL=30
# Worker prometheus server ports for /metrics (one per fleet so the
# two workers can run side-by-side on the same host).
CORE_WORKER_METRICS_PORT=9091
EGRESS_WORKER_METRICS_PORT=9092


# S3-compatible endpoint URL
S3_ENDPOINT_URL=http://localhost:9000
# Access key (username)
S3_ACCESS_KEY=rustfsadmin
# Secret key (password)
S3_SECRET_KEY=rustfsadmin
# Bucket name for file storage
S3_BUCKET_NAME=uniffy-files
# AWS region (required even for non-AWS S3-compatible storage)
S3_REGION=us-east-1
# Enable SSL for S3 connection
S3_USE_SSL=false
# S3 connection timeout in seconds
S3_CONNECT_TIMEOUT=10
# S3 read timeout in seconds
S3_READ_TIMEOUT=30
# S3 maximum retry attempts (adaptive backoff)
S3_MAX_RETRIES=3

# Chat Configuration
# Skip typing indicator fan-out for channels with more members than this limit
CHAT_TYPING_MEMBER_LIMIT=50


# LiveKit (calls SFU - container config inlined in .docker/compose/calls.yaml)
# WS URL the BROWSER uses to reach LiveKit signaling
LIVEKIT_WS_URL=ws://localhost:7880
# HTTP URL the BACKEND uses for LiveKit admin REST API (server-to-server)
LIVEKIT_HOST=http://localhost:7880
# API key/secret pair shared between LiveKit server and backend; rotate together
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-change-me-in-prod-32chars-min
# Valkey DB used by LiveKit for room registry; app uses DB 0, keep separate to
# avoid eviction / pubsub cross-impact
LIVEKIT_VALKEY_DATABASE=1


# coturn (TURN/STUN relay for WebRTC NAT traversal)
# Off by default in compose (profile `calls-turn`); most local dev does not
# need TURN. Bring up with: ./run.sh calls-turn-up (or docker compose
# --profile calls-turn up -d)
# Public URLs the BROWSER puts in its ICE servers list
COTURN_STUN_URL=stun:localhost:3478
COTURN_TURN_URL=turn:localhost:3478?transport=udp
COTURN_TURNS_URL=turns:localhost:5349?transport=tcp
# Shared secret for TURN REST API ephemeral credentials. Backend mints
# username=<expiry_timestamp>:<user_id>, password=base64(HMAC-SHA1(secret, username))
COTURN_SHARED_SECRET=uniffy-coturn-dev
COTURN_REALM=turn.localhost
# TTL of minted TURN credentials in seconds (match LiveKit JWT TTL)
COTURN_CREDENTIAL_TTL_SECONDS=21600


# Comma-separated list of Valkey cache namespaces to bypass at runtime.
# Use either a metrics namespace (first segment of the key) or a multi-segment
# prefix to disable a sub-namespace. Empty by default; set only when an
# operational issue forces a single namespace off without taking the rest down.
# Known namespaces: chat, chat:channel, perm, agent, user, provider.
CACHE_DISABLED_NAMESPACES=

# Audit log
# Comma-separated list of trusted-proxy peer IPs. When the immediate ASGI
# client matches one of these, the audit request-context middleware honours
# the leftmost entry of X-Forwarded-For as the client IP captured into
# audit_events.ip_address. With the list empty (default), the raw socket
# peer is used and X-Forwarded-For is ignored - the right setting for
# direct-connect deployments and the safe default behind an unknown LB.
TRUSTED_PROXIES=
# Opt-in for the high-volume file.uploaded audit row. Default off because
# every successful upload writes one row; turn on once storage volume has
# been characterised and compliance asks for upload attribution. Accepts
# 1 / true / yes (case-insensitive); any other value (or unset) keeps the
# emission off.
AUDIT_EVENTS_FILE_UPLOADED=false


# prometheus_client multiprocess directory. Granian forks WORKERS children;
# without multiprocess mode each child owns a private registry and a /metrics
# scrape returns one child's slice only. The bootstrap helper in
# uniffy._metrics_bootstrap auto-manages a per-component subdir under
# PROMETHEUS_MULTIPROC_BASE_DIR (default /tmp/uniffy_prom_metrics) so backend
# and worker each get their own clean directory on startup. Override either
# only when running in a container that needs a writable path elsewhere.
# PROMETHEUS_MULTIPROC_BASE_DIR=/tmp/uniffy_prom_metrics
# PROMETHEUS_MULTIPROC_DIR=  # explicit override; bypasses the per-component subdir