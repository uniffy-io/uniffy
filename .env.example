######## SERVER SECTION ########
# Host to bind the server to
HOST=0.0.0.0
# Port to listen on
PORT=8000
# Number of server worker
WORKERS=1
# Log level: debug, info, warning, error, critical
LOG_LEVEL=info
# Log output format: console (human-readable, colored) or json (structured, for log aggregators)
LOG_FORMAT=console
# Environment name: development, staging, production
ENVIRONMENT=production
# Comma-separated allowlist of frontend origins. Production deploys MUST
# supply an explicit list. Outside ENVIRONMENT=development the backend
# refuses to start with CORS_ORIGINS unset or set to `*` - wildcard +
# allow_credentials=true disables Origin-based protections in browsers.
# Example: https://app.example.com,https://admin.example.com
CORS_ORIGINS=*
# Number of trusted reverse proxies in front of the app. Audit middleware
# takes X-Forwarded-For[-N] as the client IP captured into
# audit_events.ip_address. ALSO load-bearing for per-IP rate limits: with
# this at 0 and the resolved IP being private/loopback, the per-IP bucket
# is skipped so a misconfigured proxy does not lock out every user behind
# it. Set to 1 behind a single nginx/Caddy/Traefik, 2 when chained, etc.
TRUSTED_PROXY_HOPS=0
# Public base URL of the running Uniffy app. Used to build user-facing
# links embedded in outbound email (accept-invite, password-reset,
# support-session notifications) and in any other server-rendered link.
# No trailing slash. Example: https://uniffy.acme.com, https://uniffy.mydomain.com
UNIFFY_BASE_URL=https://app.uniffy.io


######## DATABASE SECTION ########
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=uniffy
POSTGRES_PASSWORD=uniffy
POSTGRES_DB=uniffy
# Echo SQL queries to console (useful for debugging)
SQL_ECHO=false
# Database connection pool size
DB_POOL_SIZE=30
# Maximum overflow connections beyond pool size
DB_MAX_OVERFLOW=70
# Recycle connections after N seconds (prevents stale connections)
DB_POOL_RECYCLE=1800
# Seconds to wait for a connection from the pool before timing out
DB_POOL_TIMEOUT=10
# Maximum time in milliseconds for a single SQL statement
DB_STATEMENT_TIMEOUT_MS=30000
# Maximum time in seconds for asyncpg command execution
DB_COMMAND_TIMEOUT=30


######## VALKEY SECTION ########
# Valkey server hostname
VALKEY_HOST=localhost
# Valkey server port (mapped to 6380 in docker-compose)
VALKEY_PORT=6380
# Valkey password
VALKEY_PASSWORD=uniffy-valkey-dev
# Valkey database number (0-15)
VALKEY_DATABASE=0


######## MEILISEARCH SECTION ########
# Meilisearch server URL
MEILISEARCH_URL=http://localhost:7700
# Master API key for authentication
MEILISEARCH_MASTER_KEY=uniffy-dev-master-key
# HTTP request timeout in seconds
MEILISEARCH_TIMEOUT=30


######## S3 SECTION ########
# S3-compatible endpoint URL
S3_ENDPOINT_URL=http://localhost:9000
# Access key (username)
S3_ACCESS_KEY=rustfsadmin
# Secret key (password)
S3_SECRET_KEY=rustfsadmin
# Bucket name for file storage
S3_BUCKET_NAME=uniffy-files
# AWS region (required even for non-AWS S3-compatible storage)
S3_REGION=us-east-1
# Enable SSL for S3 connection
S3_USE_SSL=false
# S3 connection timeout in seconds
S3_CONNECT_TIMEOUT=10
# S3 read timeout in seconds
S3_READ_TIMEOUT=30
# S3 maximum retry attempts (adaptive backoff)
S3_MAX_RETRIES=3
# How many versions of each file to keep (1-100). Older versions are pruned
# when a new one is written; the current version always survives. A per-org
# value set on the admin storage page overrides this default.
FILE_VERSION_RETENTION=10


######## LIVEKIT SECTION ########
# LiveKit signaling endpoint for the BROWSER. A path (default) is resolved
# by the client against window.location - ws:// on http, wss:// on https -
# so the same value works on localhost, SSH tunnels (any port), and customer
# domains, and CSP stays connect-src 'self'. The edge proxy (Caddy locally,
# Envoy on cloud) forwards the path to livekit:7880. Set an absolute
# ws(s):// URL only for a split-origin setup (dedicated signaling domain).
LIVEKIT_WS_URL=/livekit
# HTTP URL the BACKEND uses for LiveKit admin REST API (server-to-server)
LIVEKIT_HOST=http://localhost:7880
# API key/secret pair shared between LiveKit server and backend; rotate together
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-change-me-in-prod-32chars-min
# Valkey DB used by LiveKit for room registry; app uses DB 0, keep separate to
# avoid eviction / pubsub cross-impact
LIVEKIT_VALKEY_DATABASE=1
# NAT traversal uses LiveKit's embedded TURN server (no separate coturn).
# Clients receive TURN candidates automatically via signaling; nothing to
# configure here. Self-host inbound ports: 7881/tcp (ICE fallback),
# 7882/udp (media), 3478/udp (TURN).
# Comma-separated TURN URIs advertised to clients (k8s/STUNner mode).
# Empty = direct media mode (embedded TURN via LiveKit signaling), the
# VM/compose default.
TURN_SERVER_URLS=
# Shared secret for ephemeral TURN credentials (TURN REST spec). Must match
# the TURN server (STUNner GatewayConfig sharedSecret). Required when
# TURN_SERVER_URLS is set.
TURN_SHARED_SECRET=
# Lifetime of minted TURN credentials. Must exceed the longest expected call;
# ICE servers cannot be rotated mid-connection.
TURN_CREDENTIAL_TTL_SECONDS=28800
# Default screen-share ceiling for channel / group calls (BALANCED | HIGH | MAX).
# A 1:1 direct call ignores this and defaults to MAX (single viewer, trivial
# egress). An org admin can override the ceiling per organization from the
# admin Calls page. BALANCED protects a small self-host media node; raise it
# when the node has bandwidth to spare.
CALLS_DEFAULT_SCREEN_SHARE_QUALITY=BALANCED


######## AUTH SECTION ########
# Secret key for JWT tokens - CHANGE THIS IN PRODUCTION
# Generate with: openssl rand -hex 32. Required; the backend refuses to
# start without it.
JWT_SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32
# Access token TTL in minutes. Hard-capped at 60 server-side - values
# above silently clamp. Refresh tokens are 90 days, not configurable.
# Refresh-token rotation + reuse detection means there is no benefit to
# raising this; long sessions ride on the refresh path.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# Public registration gate. When false, the only way
# to create a user is to accept an org invitation
ALLOW_PUBLIC_REGISTRATION=false
# A Secure/HttpOnly/SameSite cookie authenticates GET asset reads (images,
# thumbnails, avatars, media) so <img>/<video> tags work without a header.
# Mutating RPCs and uploads stay on Bearer; this cookie is never accepted for them.
# Secure defaults on outside ENVIRONMENT=development. Self-hosters serving over
# plain http on a LAN must set this off, or browsers will drop the cookie.
ASSET_COOKIE_SECURE=true
# SameSite mode. Strict is correct for the same-origin deploys both products use.
ASSET_COOKIE_SAMESITE=Strict
# Cookie TTL in minutes. Hard-capped at 240 server-side; refreshed on every
# RefreshToken so active sessions never see an asset 401.
ASSET_COOKIE_TTL_MINUTES=60




######## ENCRYPTION SECTION ########
# Master Key Encryption Key (KEK) for at-rest encryption of per-org DEKs and
# app-wide secrets (VAPID private key). Wraps every per-org Data Encryption
APP_MASTER_KEY=


######## BOOTSTRAP SECTION ########
# Users + default org seeded on a fresh database.
INITIAL_ADMIN_EMAIL=admin@uniffy.io
INITIAL_ADMIN_PASSWORD=admin
# Unset = same as admin (one combined user). Set to a distinct address
# for the cloud / multi-tenant split.
INITIAL_PLATFORM_ADMIN_EMAIL=platform@uniffy.io
# Ignored when collapsed. Falls back to INITIAL_ADMIN_PASSWORD when unset.
INITIAL_PLATFORM_ADMIN_PASSWORD=admin
# Default organization name
DEFAULT_ORG_NAME=Uniffy
# Default organization slug (auto-generated from name if not set)
# Change only if you must to.
# DEFAULT_ORG_SLUG=
# Starter content for the first organization: the Uniffy docs notes, the tags
# on them, and the Welcome canvas. Set false for a plain, empty org.
# Dev-only demo data (test users, groups, provider keys, agents, the demo
# company) is not gated here; the dev stack's one-shot seeder container owns
# it (src/uniffy/scripts/demo_company, refuses outside ENVIRONMENT=development).
# Provider keys for that seeder come from CLAUDE_API_KEY, OPENAI_API_KEY,
# GOOGLE_GENAI_API_KEY, OPENROUTER_API_KEY and XAI_API_KEY in this file.
SEED_STARTER_CONTENT=true


######## MAIL SECTION ########
# System default config. Used by every outbound mail when the sending
# organization has no per-org override
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Uniffy
MAIL_REPLY_TO=
MAIL_RATE_LIMIT_PER_MIN=100
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true


######## SUPPORT SESSION SECTION ########
# For self hosted you probably don't need to change this
SUPPORT_SESSION_MODE=OWNER_APPROVED
# Default duration suggested on the request UI (minutes)
DEFAULT_SUPPORT_SESSION_DURATION_MINUTES=30
# Hard server-side ceiling on requested duration (minutes, floor 5)
MAX_SUPPORT_SESSION_DURATION_MINUTES=120


######## PEOPLE AND DIRECTORY SECTION ########
# No env vars. The people surfaces are configured per organization, not
# per deployment, because a multi-tenant install needs one tenant to run a
# directory while another does not.
#
# The two org toggles ("People directory", "Org chart") live in
# /admin/people and are stored in org_settings under namespace 'people'.
# Both default to ON; turning them off hides the surfaces but keeps
# mention chips and hover cards working.
#
# Identity sources (LOCAL / SCIM / LDAP / OIDC) are also created per org in
# /admin/people. Every org is seeded with one LOCAL source that cannot be
# deleted or deactivated, so a fully air-gapped self-hosted deployment
# needs no configuration here at all and reaches no external service.
#
# Source secrets (bind password, SCIM bearer token, OIDC client secret)
# are NOT env vars and never live in the source's config JSON. They go to
# org_settings with is_secret=true under namespace 'identity', encrypted
# per tenant with OrgCipher and rotated with the org DEK. The only key
# material an operator supplies is ENCRYPTION_MASTER_KEY, above.


######## WORKER SECTION ########
CORE_WORKER_MAX_JOBS=10
CORE_WORKER_POLL_DELAY=0.5
EGRESS_WORKER_MAX_JOBS=50
EGRESS_WORKER_POLL_DELAY=0.05
# Job timeout in seconds for the core fleet (default: 5 minutes).
WORKER_JOB_TIMEOUT=300
# Job timeout in seconds for the egress fleet. Agent runtime jobs can
# legitimately run up to MAX_TOOL_ITERATIONS * 60s when slow tools fan
# out, so the egress ceiling is bumped above the core default.
EGRESS_WORKER_JOB_TIMEOUT=900
# How long to keep job results in seconds (default: 1 hour)
WORKER_KEEP_RESULT=3600
# Maximum retry attempts for failed jobs
WORKER_MAX_TRIES=3
# Seconds between health checks
WORKER_HEALTH_CHECK_INTERVAL=30
# Worker prometheus server ports for /metrics (one per fleet so the
# two workers can run side-by-side on the same host).
CORE_WORKER_METRICS_PORT=9091
EGRESS_WORKER_METRICS_PORT=9092


######## CONFIG SECTION ########
# Skip typing indicator fan-out for channels with more members than this limit
CHAT_TYPING_MEMBER_LIMIT=50
# should we log audit events for every file upload? Default false
AUDIT_EVENTS_FILE_UPLOADED=false
# MFA (TOTP) policy seed. When true, every is_system_admin user must
# enrol two factor authentication on their next sign in. Once an
# operator flips the toggle in /platform/server-settings, the DB row
# wins and this env value is ignored. Default: true.
MFA_REQUIRED_FOR_SYSTEM_ADMINS=true
# Break-glass MFA reset CLI. Self-host only, off by default. When set
# to 1, the operator can run
#   python -m uniffy --mfa-reset --user-email <addr> \
#     --reason <text> --operator <operator-id>
# inside the backend container/pod to disable MFA on one user without
# an authenticated session. The --operator value (or this env var, see
# UNIFFY_BREAK_GLASS_OPERATOR below) lands in the audit row's
# details.operator field; actor_user_id stays NULL with details.kind=
# break_glass. Leave both unset in cloud deploys.
ENABLE_BREAK_GLASS_CLI=
# Fallback for --operator on the break-glass CLI. An ID for the human
# running the command (email, username, or ticket ref). Required; the
# CLI refuses to run if neither --operator nor this env var is set,
# so the audit row is never anonymous.
UNIFFY_BREAK_GLASS_OPERATOR=

######## CACHE SECTION ########
# Operational kill-switch. Comma-separated Valkey namespace prefixes to
# bypass at runtime. Empty in normal operation; set during an incident
# to take one cache namespace offline without flushing everything.
# Examples: chat, chat:channel, perm, agent
# CACHE_DISABLED_NAMESPACES=


######## AGENT SKILL EVOLUTION SECTION ########
# Background skill-evolution analyzer. After a conversation goes idle, an ARQ
# job can read the transcript + feedback and propose skill drafts for review.
# Proposals are ALWAYS pending drafts - nothing activates without an explicit
# save in the UI. Off by default so self-hosted/air-gapped deploys never call
# an LLM for background analysis unless the operator turns it on. Cloud tenants
# can override per-org via the "agents" / "skill_evolution_enabled" org setting.
# AGENT_SKILL_EVOLUTION_ENABLED=false
# Per-org cap on analyzer runs per day (LLM cost guard). 0 disables analysis.
# AGENT_SKILL_ANALYSIS_DAILY_BUDGET=50


######## OBSERVABILITY SECTION ########
# prometheus_client multiprocess directory. Granian forks WORKERS children;
# without multiprocess mode each child owns a private registry and a /metrics
# scrape returns one child's slice only. The bootstrap helper in
# uniffy._metrics_bootstrap auto-manages a per-component subdir under
# PROMETHEUS_MULTIPROC_BASE_DIR (default /tmp/uniffy_prom_metrics) so backend
# and worker each get their own clean directory on startup. Override either
# only when running in a container that needs a writable path elsewhere.
# PROMETHEUS_MULTIPROC_BASE_DIR=/tmp/uniffy_prom_metrics
# PROMETHEUS_MULTIPROC_DIR=  # explicit override; bypasses the per-component subdir
